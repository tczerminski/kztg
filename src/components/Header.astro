---
import { getRelativeLocaleUrl } from "astro:i18n";
import { t, type Locale } from "../i18n/utils";
import LangSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<header
  id="siteHeader"
  class="w-full bg-white/95 backdrop-blur-sm shadow-sm fixed top-0 left-0 z-50 mobile-hidden-header"
>
  <div class="flex items-center justify-between px-4 md:px-8 py-3 text-sm sm:text-base font-semibold text-[#1f2a44] relative">
    <a href={getRelativeLocaleUrl(locale, "/")} class="flex items-center space-x-4">
      <img src="/images/logo.jpg" alt="Logo" class="w-12 h-12 rounded-full shadow-sm" />
    </a>
    <span
      class="absolute left-1/2 -translate-x-1/2"
      style="font-family: 'Dancing Script', cursive; font-weight: 700; font-size: 1.4rem; color: #111827;"
    >
      {t(locale, "site.name")}
    </span>
    <LangSwitcher locale={locale} variant="header" />
  </div>
</header>
