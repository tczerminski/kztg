---
import { t, type Locale } from "../i18n/utils";
import type { SermonView } from "../lib/sermons";

interface Props {
  locale: Locale;
  sermon: SermonView;
}

const { locale, sermon } = Astro.props;
const metaParts = [sermon.preacher, sermon.dateDisplay, sermon.durationDisplay].filter(Boolean);
---
<article class="sermon-card bg-white rounded-2xl shadow-sm flex flex-col">
  <a href={sermon.href} class="sermon-cover block relative overflow-hidden rounded-t-2xl aspect-video">
    <img
      src={sermon.cover}
      class="sermon-cover-image w-full h-full object-cover"
      alt={t(locale, "sermons.cover")}
      loading="lazy"
      onload="this.classList.add('loaded');this.parentElement.classList.add('cover-ready')"
      onerror="this.classList.add('loaded');this.parentElement.classList.add('cover-ready')"
    />
  </a>
  <div class="sermon-card-body">
    {sermon.title ? (
      <h3 class="sermon-card-title text-lg font-semibold text-gray-900 leading-tight mb-1 transition">
        <a href={sermon.href} class="hover:underline">{sermon.title}</a>
      </h3>
    ) : (
      <h3 class="sermon-card-title text-lg font-semibold text-gray-400 leading-tight mb-1 transition italic">
        <a href={sermon.href} class="hover:underline">{t(locale, "sermons.noTitle")}</a>
      </h3>
    )}
    <div class="sermon-card-meta">
      {metaParts.map((part, i) => (
        <>
          {i > 0 && <span class="sermon-card-meta-dot">·</span>}
          <span>{part}</span>
        </>
      ))}
    </div>
    {sermon.summary && (
      <p class="sermon-card-summary">
        {sermon.summary} <span class="ai-badge" aria-label={t(locale, "sermons.aiGenerated")}>✦ AI</span>
      </p>
    )}
    <div class="sermon-card-action">
      <div class="sermon-inline-player" data-sermon-player>
        <div class="sermon-inline-player__body">
          <button
            type="button"
            class="sermon-inline-player__toggle"
            data-sermon-play
            data-title={sermon.title || sermon.dateDisplay}
            data-preacher={sermon.preacher}
            data-audio={sermon.audio}
            aria-label={t(locale, "sermons.play")}
          >
            <svg data-play-icon xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            <svg data-pause-icon xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="hidden">
              <rect x="6" y="4" width="4" height="16" />
              <rect x="14" y="4" width="4" height="16" />
            </svg>
          </button>
          <input
            type="range"
            min="0"
            max="100"
            value="0"
            class="sermon-inline-player__progress"
            data-sermon-progress
            data-duration={sermon.duration || 0}
            aria-label={t(locale, "sermons.progress")}
          />
          <div class="sermon-inline-player__times">
            <span data-current-time>0:00</span>
            <span data-total-time>{sermon.durationDisplay || "0:00"}</span>
          </div>
          {sermon.isTTS && <div class="sermon-tts-notice">{t(locale, "sermons.aiVoice")}</div>}
        </div>
      </div>
    </div>
    <a href={sermon.href} class="sermon-card-details-link">
      {t(locale, "sermons.viewDetails")}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
