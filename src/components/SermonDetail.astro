---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, type Locale } from "../i18n/utils";
import type { SermonView } from "../lib/sermons";
import { getSermonTranscript, getSermonsForLocale } from "../lib/sermons";
import { buildSermonJsonLd } from "../lib/jsonld";
import SermonCard from "./SermonCard.astro";

interface Props {
  locale: Locale;
  sermon: SermonView;
}

const { locale, sermon } = Astro.props;
const transcript = await getSermonTranscript(sermon.id, locale);

const MORE_BY_PREACHER_COUNT = 3;
const moreByPreacher = sermon.preacher
  ? (await getSermonsForLocale(locale))
      .filter((s) => s.preacher === sermon.preacher && s.id !== sermon.id)
      .slice(0, MORE_BY_PREACHER_COUNT)
  : [];

const siteUrl = Astro.site?.origin ?? "https://kztg.pl";
const pageUrl = new URL(sermon.href, siteUrl).toString();
const pageTitle = `${sermon.title || t(locale, "sermons.noTitle")} | ${t(locale, "site.name")}`;
const jsonLd = buildSermonJsonLd(sermon, siteUrl, pageUrl, locale);
const metaParts = [sermon.preacher, sermon.dateDisplay, sermon.durationDisplay].filter(Boolean);
const backHref = `${getRelativeLocaleUrl(locale, "/")}#sermons`;
---
<BaseLayout
  locale={locale}
  pageTitle={pageTitle}
  pageDescription={sermon.summary || undefined}
  pageImage={sermon.cover}
  pagePath={sermon.href}
  skipHreflang
  jsonLdOverride={jsonLd}
>
  <article id="sermon-top" class="sermon-detail-article max-w-4xl mx-auto px-4 pb-12 md:pb-20">
    <a
      id="sermon-back-link-desktop"
      href={backHref}
      class="max-md:hidden inline-flex items-center gap-2 mb-6 text-[#7b8fc4] hover:text-[#263a63] hover:underline transition text-sm font-semibold"
    >
      {t(locale, "sermon.back")}
    </a>
    <div class="sermon-detail-content bg-white rounded-none sm:rounded-2xl -mx-4 sm:mx-0 px-4 sm:px-8 pb-4 sm:pb-8">
      <div class="flex items-center justify-between gap-3 mb-8 md:hidden">
        <img src="/images/logo.jpg" alt="Logo" class="w-12 h-12 rounded-full flex-shrink-0" />
        <a
          id="sermon-back-link-mobile"
          href={backHref}
          class="inline-flex items-center gap-2 px-4 py-2 border border-[#7b8fc4] text-[#7b8fc4] rounded-xl hover:bg-[#7b8fc4] hover:text-white hover:border-[#7b8fc4] transition text-sm font-semibold"
        >
          {t(locale, "sermon.back")}
        </a>
      </div>

      {sermon.cover && (
        <div class="relative overflow-hidden rounded-none sm:rounded-xl aspect-video mb-8 -mx-4 sm:mx-0">
          <img src={sermon.cover} class="w-full h-full object-cover" alt={sermon.title} loading="eager" />
        </div>
      )}

      {sermon.title ? (
        <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-2 leading-tight">{sermon.title}</h1>
      ) : (
        <h1 class="text-3xl md:text-4xl font-semibold text-gray-400 italic mb-2 leading-tight">{t(locale, "sermons.noTitle")}</h1>
      )}

      <div class="sermon-card-meta mb-8">
        {metaParts.map((part, i) => (
          <>
            {i > 0 && <span class="sermon-card-meta-dot">·</span>}
            <span>{part}</span>
          </>
        ))}
      </div>

      <div class="mb-10">
        <div class="sermon-inline-player sermon-inline-player--lg" data-sermon-player>
          <div class="sermon-inline-player__body">
            <button
              type="button"
              class="sermon-inline-player__toggle"
              data-sermon-play
              data-title={sermon.title || sermon.dateDisplay}
              data-preacher={sermon.preacher}
              data-audio={sermon.audio}
              aria-label={t(locale, "sermons.play")}
            >
              <svg data-play-icon xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
              <svg data-pause-icon xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="hidden">
                <rect x="6" y="4" width="4" height="16" />
                <rect x="14" y="4" width="4" height="16" />
              </svg>
            </button>
            <input
              type="range"
              min="0"
              max="100"
              value="0"
              class="sermon-inline-player__progress"
              data-sermon-progress
              data-duration={sermon.duration || 0}
              aria-label={t(locale, "sermons.progress")}
            />
            <div class="sermon-inline-player__times">
              <span data-current-time>0:00</span>
              <span data-total-time>{sermon.durationDisplay || "0:00"}</span>
            </div>
            {sermon.isTTS && <div class="sermon-tts-notice">{t(locale, "sermons.aiVoice")}</div>}
          </div>
        </div>
      </div>

      {sermon.summary && (
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">{t(locale, "sermon.summaryHeading")}</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            {sermon.summary} <span class="ai-badge" aria-label={t(locale, "sermons.aiGenerated")}>✦ AI</span>
          </p>
        </section>
      )}

      {transcript && (
        <section id="sermon-transcript" class="mb-10">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">{t(locale, "sermon.transcriptHeading")}</h2>
          <div class="sermon-transcript-wrap" data-transcript-wrap>
            <div class="text-gray-700 leading-relaxed whitespace-pre-line">{transcript}</div>
          </div>
          <button type="button" class="sermon-transcript-toggle hidden" data-transcript-toggle>
            {t(locale, "sermon.showMore")}
          </button>
        </section>
      )}

    </div>
  </article>

  {moreByPreacher.length > 0 && (
    <section id="sermon-more-by-preacher" class="bg-white py-12 md:py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 text-center mb-10">
          {t(locale, "sermon.moreByPreacher", { preacher: sermon.preacher })}
        </h2>
        <div class="grid gap-8 -mx-4 sm:mx-0 sm:grid-cols-2 lg:grid-cols-3">
          {moreByPreacher.map((s, i) => (
            <div class:list={["grid", i > 0 && "max-sm:hidden"]}>
              <SermonCard locale={locale} sermon={s} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .sermon-transcript-wrap {
    position: relative;
    overflow: hidden;
  }

  .sermon-transcript-wrap.is-collapsed {
    max-height: 320px;
  }

  .sermon-transcript-wrap.is-collapsed::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), white);
    pointer-events: none;
  }

  .sermon-transcript-toggle {
    display: flex;
    margin: 1rem auto 0;
    padding: 0.5rem 1.25rem;
    border: 1px solid #7b8fc4;
    color: #7b8fc4;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .sermon-transcript-toggle:hover {
    background: #7b8fc4;
    border-color: #7b8fc4;
    color: #fff;
  }

  /* No fixed header on mobile (see .mobile-hidden-header) — the white card runs
     flush to the top edge, with the safe-area/notch clearance as its own
     padding instead of a gray gap above it. */
  .sermon-detail-article {
    padding-top: 0;
  }

  .sermon-detail-content {
    padding-top: calc(env(safe-area-inset-top, 0px) + 1.5rem);
  }

  /* From md: up, #siteHeader is fixed at ~72px — clear it with room to spare,
     and the card gets its normal (smaller) top padding back. */
  @media (min-width: 768px) {
    .sermon-detail-article {
      padding-top: 8rem;
    }

    .sermon-detail-content {
      padding-top: 2rem;
    }
  }

  .sermon-inline-player--lg .sermon-inline-player__toggle {
    width: 3.75rem;
    height: 3.75rem;
  }

  .sermon-inline-player--lg .sermon-inline-player__progress::-webkit-slider-runnable-track {
    height: 8px;
  }

  .sermon-inline-player--lg .sermon-inline-player__progress::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -5px;
  }

  .sermon-inline-player--lg .sermon-inline-player__progress::-moz-range-track {
    height: 8px;
  }

  .sermon-inline-player--lg .sermon-inline-player__progress::-moz-range-thumb {
    width: 18px;
    height: 18px;
  }

  .sermon-inline-player--lg .sermon-inline-player__times {
    font-size: 1rem;
  }

</style>
