---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, defaultLocale } from "../i18n/utils";
import { buildSongJsonLd } from "../lib/jsonld";
import { getSongs } from "../lib/songs";
import type { SongView } from "../lib/songs";
import SongCard from "./SongCard.astro";

interface Props {
  song: SongView;
}

const { song } = Astro.props;
const locale = defaultLocale;

const pageTitle = `${song.number}. ${song.title} | ${t(locale, "site.name")}`;
const backHref = `${getRelativeLocaleUrl(locale, "/")}#songs`;

const RELATED_COUNT = 4;
const relatedSongs = (await getSongs())
  .filter((s) => s.id !== song.id)
  .sort((a, b) => Math.abs(a.number - song.number) - Math.abs(b.number - song.number))
  .slice(0, RELATED_COUNT)
  .sort((a, b) => a.number - b.number);

const siteUrl = Astro.site?.origin ?? "https://kztg.pl";
const pageUrl = new URL(song.href, siteUrl).toString();
const jsonLd = buildSongJsonLd(song, siteUrl, pageUrl);
const firstLine = song.verses[0]?.lines.join(" ") ?? "";
const pageDescription =
  firstLine.length > 155 ? firstLine.slice(0, 155).trimEnd() + "…" : firstLine || undefined;
---
<BaseLayout
  locale={locale}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pagePath={song.href}
  skipHreflang
  jsonLdOverride={jsonLd}
>
  <article id="song-top" class="sermon-detail-article max-w-4xl mx-auto px-4 pb-12 md:pb-20">
    <a
      id="song-back-link-desktop"
      href={backHref}
      class="max-md:hidden inline-flex items-center gap-2 mb-6 text-[#7b8fc4] hover:text-[#263a63] hover:underline transition text-sm font-semibold"
    >
      {t(locale, "song.back")}
    </a>
    <div class="sermon-detail-content bg-white rounded-none sm:rounded-2xl -mx-4 sm:mx-0 px-4 sm:px-8 pb-4 sm:pb-8">
      <div class="flex items-center justify-between gap-3 mb-8 md:hidden">
        <img src="/images/logo.jpg" alt="Logo" class="w-12 h-12 rounded-full flex-shrink-0" />
        <a
          id="song-back-link-mobile"
          href={backHref}
          class="inline-flex items-center gap-2 px-4 py-2 border border-[#7b8fc4] text-[#7b8fc4] rounded-xl hover:bg-[#7b8fc4] hover:text-white hover:border-[#7b8fc4] transition text-sm font-semibold"
        >
          {t(locale, "song.back")}
        </a>
      </div>

      <div class="song-heading">
        <p class="song-number-label">{t(locale, "song.number", { number: song.number })}</p>
        <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 leading-tight">{song.title}</h1>
      </div>
      <hr class="song-divider" />

      <div class="song-verses space-y-6">
        {song.verses.map((verse, i) => (
          <div class="song-verse">
            <span class="song-verse-number">{i + 1}</span>
            <p class="song-verse-lines text-lg text-gray-700 leading-relaxed whitespace-pre-line">
              {verse.lines.join("\n")}
            </p>
          </div>
        ))}
      </div>
    </div>
  </article>

  {relatedSongs.length > 0 && (
    <section id="song-related" class="py-12 md:py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 text-center mb-10">
          {t(locale, "song.related")}
        </h2>
        <div class="song-list rounded-none sm:rounded-2xl overflow-hidden -mx-4 sm:mx-auto max-w-xl columns-1 gap-x-0">
          {relatedSongs.map((s) => <SongCard song={s} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .song-number-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 0.5rem;
  }

  .song-divider {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 1.5rem 0 2rem;
  }

  .song-verse {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .song-verse-number {
    flex-shrink: 0;
    width: 1.75rem;
    padding-top: 0.15rem;
    text-align: right;
    color: #9ca3af;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .song-verse-lines {
    flex: 1;
    min-width: 0;
  }

  /* No fixed header on mobile (see .mobile-hidden-header) — the white card runs
     flush to the top edge, with the safe-area/notch clearance as its own
     padding instead of a gray gap above it. */
  .sermon-detail-article {
    padding-top: 0;
  }

  .sermon-detail-content {
    padding-top: calc(env(safe-area-inset-top, 0px) + 1.5rem);
  }

  /* From md: up, #siteHeader is fixed at ~72px — clear it with room to spare,
     and the card gets its normal (smaller) top padding back. */
  @media (min-width: 768px) {
    .sermon-detail-article {
      padding-top: 8rem;
    }

    .sermon-detail-content {
      padding-top: 2rem;
    }
  }

</style>
