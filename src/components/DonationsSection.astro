---
import { t, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<section id="darowizny" class="py-20 bg-white">
  <div class="container mx-auto sm:px-4">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <p class="text-sm uppercase tracking-[0.3em] text-[#5a6f9f] mb-3">{t(locale, "donations.label")}</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-gray-900">{t(locale, "donations.heading")}</h2>
      <p class="text-gray-600 mt-4">{t(locale, "donations.desc")}</p>
    </div>
    <div class="max-w-xl mx-auto sm:rounded-2xl shadow-sm sm:mx-auto overflow-hidden" style="background: #eef0fa">
      <div class="flex items-start gap-4 px-6 sm:px-8 py-5">
        <div class="mt-1 shrink-0 w-10 h-10 rounded-full bg-[#3f568f] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v9a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-[#5a6f9f] mb-1">{t(locale, "donations.recipient")}</p>
          <p class="font-semibold text-gray-900">Kościół Zmartwychwstałego w Tarnowskich Górach</p>
        </div>
      </div>
      <div class="flex items-start gap-4 px-6 sm:px-8 py-5 border-t border-white/40" style="background: #f8f9fe">
        <div class="mt-1 shrink-0 w-10 h-10 rounded-full bg-[#3f568f] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <path stroke-linecap="round" d="M2 10h20" />
          </svg>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-[#5a6f9f] mb-1">{t(locale, "donations.account")}</p>
          <p class="font-mono font-semibold text-gray-900 tracking-wide">
            <span class="bank-account--desktop">19 1600 1462 1711 2977 6000 0001</span>
            <span class="bank-account--mobile">19160014621711297760000001</span>
          </p>
          <p class="text-sm text-gray-500 mt-0.5">BNP Paribas Bank Polska S.A.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 px-6 sm:px-8 py-5 border-t border-white/40">
        <div class="mt-1 shrink-0 w-10 h-10 rounded-full bg-[#3f568f] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-[#5a6f9f] mb-1">{t(locale, "donations.transferTitle")}</p>
          <p class="font-semibold text-gray-900">{t(locale, "donations.purpose")}</p>
        </div>
      </div>
    </div>
  </div>
</section>
