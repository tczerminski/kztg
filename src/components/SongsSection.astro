---
import { t } from "../i18n/utils";
import { defaultLocale } from "../i18n/utils";
import { getSongs } from "../lib/songs";

const locale = defaultLocale;
const songs = await getSongs();

const clientStrings = {
  newer: t(locale, "songs.newer"),
  older: t(locale, "songs.older"),
  page: t(locale, "songs.page"),
  noResults: t(locale, "songs.noResults"),
};
---
<section id="songs" class="py-20 md:py-28 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center mb-10">
      <p class="text-sm uppercase tracking-[0.3em] text-[#5a6f9f] mb-3">{t(locale, "songs.label")}</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-gray-900">{t(locale, "songs.heading")}</h2>
      <p class="text-gray-600 mt-4">{t(locale, "songs.desc")}</p>
      <div class="mt-8 relative max-w-xl mx-auto">
        <label class="sr-only" for="songs-search">{t(locale, "songs.searchLabel")}</label>
        <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path stroke-linecap="round" d="m20 20-3.5-3.5" />
        </svg>
        <input
          id="songs-search"
          type="search"
          placeholder={t(locale, "songs.searchPlaceholder")}
          class="w-full bg-white border-2 border-gray-200 rounded-2xl pl-12 pr-4 py-4 text-base sm:text-lg focus:outline-none focus:border-[#7b8fc4] focus:ring-2 focus:ring-[#7b8fc4]/30"
        />
      </div>
      <button id="songs-show-all" type="button" class="mt-4 text-sm font-semibold text-[#7b8fc4] hover:text-[#263a63] hover:underline transition">
        {t(locale, "songs.showAll", { count: songs.length })}
      </button>
    </div>
    <div id="songs-grid" class="song-list rounded-none sm:rounded-2xl overflow-hidden -mx-4 sm:mx-auto sm:max-w-xl columns-1 hidden"></div>
    <nav id="songs-nav" class="flex flex-wrap justify-center items-center gap-3 mt-12 text-center"></nav>
  </div>
</section>

<script is:inline type="application/json" id="songs-data" set:html={JSON.stringify(songs)} />
<script is:inline type="application/json" id="songs-i18n" set:html={JSON.stringify(clientStrings)} />
