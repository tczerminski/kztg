{
  "title": "Wszystko dokoła chwali Pana",
  "verses": [
    {
      "lines": [
        "Wszystko dokoła chwali Pana",
        "Wszystko dokoła chwali Boga",
        "Wszystko dokoła chce uwielbiać",
        "Jego imię"
      ]
    },
    {
      "lines": [
        "Chwal Boga z nami",
        "Chwal Jego imię"
      ]
    }
  ]
}
