{
  "title": "Witaj Jezu! O cześć Ci królu",
  "verses": [
    {
      "lines": [
        "Witaj Jezu!",
        "O cześć Ci królu",
        "Przyjmij śpiew nasz,",
        "Modlitwę, wielbienie",
        "Boży synu!"
      ]
    },
    {
      "lines": [
        "Dziś ku Tobie",
        "Wznosimy ręce swe",
        "Na znak szacunku, miłości,",
        "Wdzięczności o, alleluja!"
      ]
    },
    {
      "lines": [
        "Alleluja"
      ]
    }
  ]
}
