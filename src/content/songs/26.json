{
  "title": "Bogaty w każdy cud",
  "verses": [
    {
      "lines": [
        "Bogaty w każdy cud",
        "Bogaty słowem ust",
        "Ty – święty nasz Bóg",
        "Bogaty każdy kto",
        "Przebywa tam gdzie Ty",
        "I strzeże Twych dróg"
      ]
    },
    {
      "lines": [
        "Ty dajesz najcenniejszą",
        "Radość w moim życiu",
        "Obecność słodką swą",
        "Ty dajesz mi swą moc",
        "Gdy modlę się w ukryciu",
        "I skłaniam się u Twych stóp"
      ]
    },
    {
      "lines": [
        "(: Święty Bóg,",
        "Wszechmogący Jezus",
        "Uwielbiam Cię,",
        "Godzien chwały tyś jest :)"
      ]
    },
    {
      "lines": [
        "Tak bardzo potrzebuję obecności Twej",
        "Tak bardzo pragnę Cię dziś",
        "Tak bardzo oczekuję byś objawił się",
        "Drogi Jezu proszę przyjdź"
      ]
    }
  ]
}
