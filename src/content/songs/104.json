{
  "title": "Duchu żyjącego Boga",
  "verses": [
    {
      "lines": [
        "Duchu żyjącego Boga",
        "Dziś na mnie zstąp"
      ]
    },
    {
      "lines": [
        "Złam mnie, skrusz mnie",
        "Napełń, użyj",
        "Duchu żyjącego Boga",
        "Dziś na mnie zstąp"
      ]
    }
  ]
}
