{
  "title": "Pana chwalić chcę",
  "verses": [
    {
      "lines": [
        "(: Pana chwalić chcę :)",
        "Całym sercem",
        "Ze wszystkich swych sił",
        "Pana chwalić chcę"
      ]
    },
    {
      "lines": [
        "Wielbij Go i czcij",
        "To królów król",
        "Jezus to Pan niechaj świat",
        "Wciąż śpiewa mu",
        "Chwal Go wywyższaj",
        "Imię Jego sław"
      ]
    }
  ]
}
