{
  "title": "Przed obliczem Pana",
  "verses": [
    {
      "lines": [
        "Przed obliczem Pana uniżmy się"
      ]
    },
    {
      "lines": [
        "Pan sam wywyższy nas",
        "Jego jest ziemia i czas",
        "Pan sam wywyższy nas"
      ]
    },
    {
      "lines": [
        "Wszystkie nasze troski oddajmy mu"
      ]
    }
  ]
}
