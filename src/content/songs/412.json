{
  "title": "Panie, tutaj dziś odpocząć chciej",
  "verses": [
    {
      "lines": [
        "Panie tutaj dziś odpocząć chciej",
        "Twój lud przed Tobą skłania się",
        "Z wdzięcznością chcemy",
        "Wielbić Cię",
        "Z radością więc",
        "Witamy Ciebie tu dziś"
      ]
    }
  ]
}
