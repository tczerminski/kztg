{
  "title": "Zeszliśmy się znów",
  "verses": [
    {
      "lines": [
        "Zeszliśmy się znów",
        "By Pana dziś czcić",
        "Zeszliśmy się znów",
        "By uczyć się żyć"
      ]
    },
    {
      "lines": [
        "Coś cennego wziąć od Boga",
        "Przyjąć każde Jego słowo",
        "Zeszliśmy się znów",
        "By uczyć się żyć"
      ]
    }
  ]
}
