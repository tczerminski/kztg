{
  "title": "Będę cieszyć się wciąż",
  "verses": [
    {
      "lines": [
        "Będę cieszyć się wciąż",
        "Panem mym",
        "Radością mą zawsze będzie Bóg",
        "Przyodział mnie Pan",
        "Okrywając swym zbawieniem",
        "Płaszcz sprawiedliwości",
        "Sam nałożył mi"
      ]
    }
  ]
}
