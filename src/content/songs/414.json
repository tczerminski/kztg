{
  "title": "Panie, Twój tron wznosi się",
  "verses": [
    {
      "lines": [
        "Panie Twój tron wznosi się",
        "Nad wszystkie ziemie świata",
        "Jesteś najwyższy Panie mój,",
        "Królu mój"
      ]
    },
    {
      "lines": [
        "(: Wywyższamy Cię! :)",
        "Wywyższamy Cię! Panie nasz"
      ]
    },
    {
      "lines": [
        "Najwyższym Bogiem tyś",
        "Na ziemi tej",
        "Nad wszystkich bogów",
        "Pan większy jest"
      ]
    }
  ]
}
