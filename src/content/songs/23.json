{
  "title": "Błogosławiony będziesz",
  "verses": [
    {
      "lines": [
        "Błogosławiony będziesz w mieście",
        "Szczęśliwi na roli",
        "Dom pełen dzieci, obfitość w Nim chleba",
        "Spichlerze pełne, stada ogromne",
        "Sady w owoc bogate",
        "Szczęsne będzie wejście Twe",
        "Wyjście też błogosławione"
      ]
    },
    {
      "lines": [
        "I stanie się, jeśli z pilnością",
        "Będziesz słuchał głosu Pana",
        "Wypełniając to, co ci przykazał",
        "Wywyższy ciebie ponad wszystkie",
        "Narody ziemi",
        "I spłyną na ciebie błogosławieństwa"
      ]
    },
    {
      "lines": [
        "Wnieś do spichlerza swą dziesięcinę",
        "By był zapas w domu moim",
        "I chciej doświadczyć mnie",
        "Tak mówi Pan",
        "Czy nie otworzę Tobie okien",
        "Okien niebiańskich",
        "By zlać przeobfite błogosławieństwa"
      ]
    }
  ]
}
