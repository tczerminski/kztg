{
  "title": "Boża miłość jest jako Słońce",
  "verses": [
    {
      "lines": [
        "Boża miłość jest",
        "Jako słońce – ona zawsze",
        "I wszędzie nam lśni"
      ]
    },
    {
      "lines": [
        "Wyjdź jej tylko naprzeciw",
        "Weź z niej tyle ile chcesz"
      ]
    },
    {
      "lines": [
        "Napełniony miłością",
        "Czyń co ona szepce Ci"
      ]
    },
    {
      "lines": [
        "Podaj tę miłość dalej",
        "Tym, co wokół Ciebie są"
      ]
    }
  ]
}
