{
  "title": "To szczęśliwy dzień",
  "verses": [
    {
      "lines": [
        "To szczęśliwy dzień",
        "Dziękuję Bogu za pogodę",
        "To szczęśliwy dzień",
        "I dla Pana przeżywam go",
        "To szczęśliwy dzień i wszystko będzie dobrze",
        "Żyjąc w każdym dniu słowem, które daje Pan."
      ]
    }
  ]
}
