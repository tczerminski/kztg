{
  "title": "Jezus! Jezus! Jezus! Ile treści w imieniu tym!",
  "verses": [
    {
      "lines": [
        "Jezus! Jezus! Jezus!",
        "Ile treści w imieniu tym!",
        "Zbawca! Mistrz mój! Jezus!",
        "Jak woń kwiatów",
        "Tchnie w sercu mym"
      ]
    },
    {
      "lines": [
        "Jezus! Jezus! Jezus!",
        "Cała ziemia niech wieść tę zna:",
        "Ziemskich królestw",
        "Czas skończy się wnet",
        "Imię Jezus – na wieki trwa"
      ]
    }
  ]
}
