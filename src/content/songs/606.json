{
  "title": "Wciąż chwalcie go",
  "verses": [
    {
      "lines": [
        "Wciąż chwalcie go",
        "Wszyscy słudzy pańscy wraz",
        "Gdy tak co dzień",
        "W domu Pańskim chcecie trwać",
        "I w świętej czci",
        "Wznieście ręce swe",
        "Wciąż chwalcie Go"
      ]
    }
  ]
}
