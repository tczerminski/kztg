{
  "title": "Memu Bogu, królowi",
  "verses": [
    {
      "lines": [
        "Memu Bogu, królowi",
        "Będę śpiewać tę pieśń",
        "Teraz, zawsze, na wieki, amen"
      ]
    },
    {
      "lines": [
        "(: Alleluja :)",
        "Amen"
      ]
    },
    {
      "lines": [
        "Więcej Jezusa we mnie",
        "A mnie coraz mniej",
        "Teraz, zawsze, na wieki, amen"
      ]
    }
  ]
}
