{
  "title": "Ojcze połącz nas",
  "verses": [
    {
      "lines": [
        "(: Ojcze połącz nas :)",
        "Aby poznał świat",
        "Żeś nam syna dał",
        "Ojcze połącz nas"
      ]
    },
    {
      "lines": [
        "(: O jak to dobrze i miło",
        "Gdy bracia w zgodzie żyją :)",
        "Tam Pan zsyła błogosławieństwo swoje"
      ]
    },
    {
      "lines": [
        "(: O jak to dobrze i miło",
        "Gdy siostry w zgodzie żyją :)",
        "Tam Pan zsyła błogosławieństwo swoje"
      ]
    },
    {
      "lines": [
        "(: O jak to dobrze i miło",
        "Gdy wszyscy w zgodzie żyją :)",
        "Tam Pan zsyła błogosławieństwo swoje"
      ]
    }
  ]
}
