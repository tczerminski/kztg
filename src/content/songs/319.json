{
  "title": "Nie szczycę się",
  "verses": [
    {
      "lines": [
        "Nie szczycę się mądrością, Panie",
        "Nie szczycę się",
        "Z dostatku swych sił",
        "Nie jestem dumny",
        "Z tego, co posiadam",
        "Tylko Tobą Panie szczycę się!"
      ]
    },
    {
      "lines": [
        "Jakże wzniosły jest Twój tron",
        "Ty rządzisz narodami",
        "Jakże wzniosły jest Twój tron",
        "Cała ziemia drży",
        "Jakże wzniosły jest Twój tron",
        "Stwórco mój i zbawco mój",
        "Tylko Tobą szczycę się!"
      ]
    }
  ]
}
