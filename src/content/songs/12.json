{
  "title": "Bądź błogosławiony",
  "verses": [
    {
      "lines": [
        "Bądź błogosławiony",
        "Nasz Boże",
        "Ty byłeś, jesteś",
        "I masz przyjść",
        "Bądź błogosławiony",
        "Nasz Boże",
        "Na wieki wieczne trwasz"
      ]
    },
    {
      "lines": [
        "Niebiański Ojcze kochamy Cię",
        "Wywyższać chcemy",
        "Święte imię Twe",
        "Twe królestwo niechaj będzie",
        "Utwierdzone w nas",
        "Swą potęgę",
        "Objawiaj w ludzie swym"
      ]
    },
    {
      "lines": [
        "Najświętszy Boże",
        "Wywyższamy Cię",
        "Kładziemy wszystko dziś",
        "Przed tronem Twym",
        "Wonność Twojej obecności",
        "Odczuwamy wciąż",
        "Gdy wielbimy wspaniałe imię Twe"
      ]
    }
  ]
}
