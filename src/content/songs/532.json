{
  "title": "Tam na krzyżu, na golgocie",
  "verses": [
    {
      "lines": [
        "Tam na krzyżu, na golgocie",
        "Umarł Jezus za grzechy i choroby Twe",
        "On zmartwychwstał, śmierć pokonał",
        "Z grobu powstał",
        "Tak prawdziwie żyje Pan"
      ]
    },
    {
      "lines": [
        "(: Nie bój sie tylko wierz :) x3",
        "Zaufaj Jezusowi dziś"
      ]
    }
  ]
}
