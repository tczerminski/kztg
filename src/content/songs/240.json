{
  "title": "Każdy dzień z Jezusem",
  "verses": [
    {
      "lines": [
        "Każdy dzień z Jezusem",
        "Jest słodszy niż miniony dzień",
        "Każdy dzień z Jezusem",
        "Rozprasza smutku cień",
        "Jezus mój mnie zbawił",
        "Oczyścił serce",
        "Z grzesznych drgnień",
        "Każdy dzień z Jezusem",
        "Jest słodszy niż miniony dzień"
      ]
    }
  ]
}
