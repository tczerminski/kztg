{
  "title": "Bo nikt nie ma z nas",
  "verses": [
    {
      "lines": [
        "Bo nikt nie ma z nas",
        "Tego, co mamy razem",
        "Gdy każdy wnosi ze sobą",
        "To, co ma"
      ]
    },
    {
      "lines": [
        "Zatem aby wszystko mieć",
        "Potrzebujemy siebie razem",
        "Bracie, siostro",
        "Ręka w rękę razem idź"
      ]
    }
  ]
}
