{
  "title": "Oto tutaj jest miejsce święte",
  "verses": [
    {
      "lines": [
        "Oto tutaj jest miejsce święte",
        "Kiedy przed obliczem Twoim, Panie",
        "Dziś stoimy",
        "Pozwól nam wielbić Jezusa",
        "Gdy na miejscu świętym",
        "Tu, przed Tobą stoimy dziś"
      ]
    }
  ]
}
