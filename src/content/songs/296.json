{
  "title": "Nadchodzi Pan w swej mocy i chwale",
  "verses": [
    {
      "lines": [
        "Nadchodzi Pan",
        "W swej mocy i chwale",
        "Nadchodzi Pan zaśpiewaj mu pieśń",
        "Nadchodzi Pan hosanna! Hosanna!",
        "Nadchodzi Pan",
        "Wznieś jemu pieśń chwał!"
      ]
    },
    {
      "lines": [
        "To nasz Pan przychodzi na syjon",
        "Będzie tam pośród naszych chwał",
        "Chwalić Go i wielbić będziemy tam",
        "Gdy do siebie weźmie nas!"
      ]
    }
  ]
}
