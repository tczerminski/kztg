{
  "title": "Postanowiłem iść za Jezusem",
  "verses": [
    {
      "lines": [
        "Postanowiłem iść za Jezusem",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Chociaż samotny tą drogą idę",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Ten świat jest za mną",
        "A krzyż przede mną",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Ach zabierz świat ten,",
        "A daj mi zbawcę",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Nikt nie obiecał,",
        "Że będzie łatwo",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Szczęśliwy jestem,",
        "Że mam Jezusa",
        "(: Nie wrócę już! :)"
      ]
    },
    {
      "lines": [
        "Bóg nam obiecał,",
        "(: Że będzie z nami! :)"
      ]
    }
  ]
}
