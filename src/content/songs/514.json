{
  "title": "Świętemu Bogu oddaj cześć",
  "verses": [
    {
      "lines": [
        "Świętemu Bogu oddaj cześć",
        "Dziękczynną z serca śpiewaj pieśń",
        "Jezusa – syna swego",
        "Bóg darował nam!"
      ]
    },
    {
      "lines": [
        "W Nim słaby mocnym staje się",
        "Biedny niechaj wyzna, że",
        "Bogaty jest,",
        "Bo wszystko dał nam Bóg"
      ]
    }
  ]
}
