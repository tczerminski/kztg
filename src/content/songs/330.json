{
  "title": "Niech strumienie żywej wody",
  "verses": [
    {
      "lines": [
        "Niech strumienie żywej wody",
        "Wypłyną ze mnie dziś.",
        "Niech strumienie żywej wody",
        "Wypłyną ze mnie dziś.",
        "Wołam: \"przyjdź, wypełnij mnie.",
        "Przyjdź, wypełnij mnie",
        "Duchu Święty.\""
      ]
    },
    {
      "lines": [
        "Przyjdźcie więc wszyscy spragnieni – mówi Pan.",
        "Przyjdźcie więc i pijcie, by nie pragnąć już.",
        "Bo kto wierzy we mnie w tym, rzeki żywej wody wytrysną."
      ]
    }
  ]
}
