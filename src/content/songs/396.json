{
  "title": "Pan mój cudowny jest",
  "verses": [
    {
      "lines": [
        "Pan mój cudowny jest",
        "Imię potężne ma",
        "Jezus – to imię brzmi",
        "Jezus mój Pan!"
      ]
    },
    {
      "lines": [
        "Potężnym Bogiem jest On",
        "Nad wszystko Jego tron",
        "Jezus – to imię brzmi",
        "Jezus mój Pan!"
      ]
    },
    {
      "lines": [
        "On mym pasterzem",
        "Skałą odwieczną",
        "Wszechmocnym Bogiem On jest",
        "Hołd mu oddajmy",
        "Pieśnią Go czcijmy",
        "Jezus – to imię brzmi",
        "Jezus mój Pan!"
      ]
    }
  ]
}
