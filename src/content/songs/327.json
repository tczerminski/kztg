{
  "title": "Niech Ci błogosławi Pan nowe",
  "verses": [
    {
      "lines": [
        "Niech Ci błogosławi Pan",
        "Niechaj Cię strzeże",
        "Niech rozjaśni oblicze swe nad Tobą",
        "I niech miłościw Ci będzie"
      ]
    },
    {
      "lines": [
        "Niech Ci błogosławi Pan",
        "Niechaj Cię strzeże",
        "Niech obróci twarz swoją ku Tobie",
        "I niech da Ci swój pokój"
      ]
    },
    {
      "lines": [
        "Niech Ci błogosławi Pan"
      ]
    },
    {
      "lines": [
        "Niech wam błogosławi Pan",
        "Niechaj was strzeże",
        "Niech rozjaśni",
        "Oblicze swe nad wami",
        "I niech miłościw wam będzie"
      ]
    },
    {
      "lines": [
        "Niech wam błogosławi Pan",
        "Niechaj was strzeże",
        "Niech obróci",
        "Twarz swoją ku Tobie",
        "I niech da Ci swój pokój"
      ]
    },
    {
      "lines": [
        "Niech wam błogosławi Pan"
      ]
    }
  ]
}
