{
  "title": "Król królów, Pan panów, Jezus jest królem",
  "verses": [
    {
      "lines": [
        "Królów król panów Pan",
        "Jezus jest królem wszechświata"
      ]
    },
    {
      "lines": [
        "Wszystko co mam",
        "Chętnie oddam mu",
        "Jezus Panem mym jest!"
      ]
    }
  ]
}
