{
  "title": "Wiele jest serc, które czekają",
  "verses": [
    {
      "lines": [
        "Wiele jest serc",
        "Które czekają na ewangelię",
        "Wiele jest serce",
        "Które czekają wciąż"
      ]
    },
    {
      "lines": [
        "Napełnij serce swoje",
        "Tym kosztownym nasieniem",
        "A zobaczysz ze Bóg",
        "Zaprowadzi Cię do ludzi",
        "(: Których będziesz mógł",
        "Przyprowadzić do Chrystusa :)"
      ]
    }
  ]
}
