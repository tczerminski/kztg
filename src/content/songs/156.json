{
  "title": "Imię Jego jest wielkie",
  "verses": [
    {
      "lines": [
        "Imię Jego jest wielkie",
        "A chwała ponad niebo i świat",
        "Święty jest nasz Pan",
        "Bóg wszechmocny",
        "On był, On jest dziś",
        "I ma wkrótce przyjść"
      ]
    },
    {
      "lines": [
        "Imię Jego jest wielkie",
        "A chwała ponad niebo i świat",
        "Święty jest nasz Pan",
        "Bóg wszechmocny",
        "On objął chwały tron",
        "I na wieki żyje już"
      ]
    }
  ]
}
