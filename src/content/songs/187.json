{
  "title": "Jesteś królem",
  "verses": [
    {
      "lines": [
        "Jesteś królem (jesteś królem)",
        "Jesteś królem (jesteś królem)",
        "Królem jest Pan"
      ]
    },
    {
      "lines": [
        "Podnieśmy wszyscy nasze serca",
        "Podnieśmy wszyscy nasze dłonie",
        "I stańmy przed obliczem Boga",
        "Wielbiąc go"
      ]
    }
  ]
}
