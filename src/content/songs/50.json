{
  "title": "Chcę, Panie, chwalić Cię",
  "verses": [
    {
      "lines": [
        "Chcę Panie chwalić Cię",
        "Więcej z dnia na dzień",
        "Chcę Panie chwalić Cię",
        "Więcej z dnia na dzień",
        "Szukać twarzy Twej",
        "I poznawać wolę Twą",
        "Chcę Panie chwalić Cię"
      ]
    },
    {
      "lines": [
        "Ptaki na niebie Ciebie chwalić chcą",
        "Drzewa na polach Ciebie wielbić chcą",
        "A ja śpiewać chcę",
        "Ciebie Panie wielbić chcę",
        "Chcę Panie chwalić Cię"
      ]
    }
  ]
}
