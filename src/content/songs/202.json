{
  "title": "Jezu miły duszy mej",
  "verses": [
    {
      "lines": [
        "Jezu, miły duszy mej",
        "Jezu – nigdy nie zostawisz mnie",
        "Wyrwałeś mnie",
        "Z błotnistego dna",
        "Na skale postawiłeś",
        "I teraz wiem"
      ]
    },
    {
      "lines": [
        "Ja kocham, potrzebuję",
        "Choćby runął świat",
        "Ty nie opuścisz mnie",
        "Mój zbawco, mój przyjacielu",
        "Będę wielbić Cię",
        "Do końca moich dni"
      ]
    },
    {
      "lines": [
        "Wielbię Cię, Panie",
        "Ze wszystkich moich sił"
      ]
    }
  ]
}
