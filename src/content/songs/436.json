{
  "title": "Pozwól mi się dotknąć Ciebie, Panie",
  "verses": [
    {
      "lines": [
        "Pozwól mi się",
        "Dotknąć Ciebie Panie",
        "Pragnę zbliżyć się",
        "Do Twej świętości",
        "Chciałbym zawsze być",
        "Już z Tobą",
        "I ujrzeć Twoją twarz",
        "Pozwól mi zobaczyć Ciebie dziś"
      ]
    }
  ]
}
