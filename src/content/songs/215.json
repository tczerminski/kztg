{
  "title": "Jezus jak wspaniałe jest imię",
  "verses": [
    {
      "lines": [
        "Jezus, jak wspaniałe jest",
        "Imię to, w którym Bóg",
        "Zbawienie nam dał",
        "Radość i pokój, moc i nadzieja",
        "Sprawia, że niknie wszelki strach",
        "Jezus, jak cudowny to Pan"
      ]
    },
    {
      "lines": [
        "Jezus prawdę objawił nam",
        "Przyszłość ma w rękach Twych",
        "Bezpieczna jest",
        "Miłość i wolność, życie Twe",
        "Sprawia, że niknie wszelki strach",
        "Jezus, jak cudowny to Pan"
      ]
    },
    {
      "lines": [
        "Jezus, On wybawcą jest",
        "Podniósł mnie, zabrał wstyd",
        "Przebaczył mój grzech",
        "Uwolnienie przez Jego moc",
        "Sprawia, że niknie wszelki strach",
        "Jezus, jak cudowny to Pan"
      ]
    }
  ]
}
