{
  "title": "Mój Pan mocą moją jest",
  "verses": [
    {
      "lines": [
        "Mój Pan mocą moją jest",
        "Pieśnią i zbawieniem – On Bogiem mym"
      ]
    },
    {
      "lines": [
        "Dla Ciebie otwieram serce me"
      ]
    },
    {
      "lines": [
        "Mój Pan królem królów jest",
        "Na zawsze i na wieki, amen"
      ]
    }
  ]
}
