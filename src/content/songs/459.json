{
  "title": "Raduj się z nami i ogłoś to",
  "verses": [
    {
      "lines": [
        "(: Raduj się z nami",
        "I ogłoś to wszystkim",
        "Że Jezus królem jest! :) X3",
        "Że Jezus Chrystus",
        "Królem królów jest!"
      ]
    },
    {
      "lines": [
        "Plotkujesz o ludziach",
        "I mówisz o rzeczach,",
        "Które nie obchodzą Cię nic",
        "Omawiasz pogodę",
        "Roztrząsasz problemy",
        "Jakie w kraju, świecie są wciąż"
      ]
    },
    {
      "lines": [
        "Lecz chcę Ci oznajmić",
        "Wspaniałą nowinę",
        "O niej śpiewać, krzyczeć chcę!",
        "Że Jezus Chrystus",
        "Królem królów jest!"
      ]
    }
  ]
}
