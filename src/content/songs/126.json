{
  "title": "Gdy dotykasz mego życie się",
  "verses": [
    {
      "lines": [
        "Gdy dotykasz mego życia",
        "Się ręką swą",
        "To budzi w sercu moim pieśń",
        "Panie kocham Cię!"
      ]
    },
    {
      "lines": [
        "Z głębi ducha ślę",
        "Wyznanie to miłe Ci",
        "Tyś jest mój król!",
        "Tyś jest mój Bóg!",
        "Panie, kocham Cię!"
      ]
    }
  ]
}
