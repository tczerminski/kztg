{
  "title": "Pokojem moim Bóg",
  "verses": [
    {
      "lines": [
        "Pokojem moim Bóg",
        "On skruszył wszelki mur",
        "Pokojem Bóg! Pokojem mym"
      ]
    },
    {
      "lines": [
        "Złóż na niego ciężar swój",
        "On Ci pomoc swą da",
        "Pokojem Bóg! Pokojem mym!"
      ]
    },
    {
      "lines": [
        "Pokojem Twoim Bóg",
        "On skruszył wszelki mur",
        "Pokojem Bóg! Pokojem Twym"
      ]
    },
    {
      "lines": [
        "Złóż na niego ciężar swój",
        "On Ci pomoc swą da",
        "Pokojem Bóg! Pokojem Twym!"
      ]
    }
  ]
}
