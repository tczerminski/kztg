{
  "title": "Przyjdź Duchu Święty, Twój kościół woła",
  "verses": [
    {
      "lines": [
        "Przyjdź Duchu Święty",
        "Twój kościół woła i wzdycha",
        "Przyjdź!",
        "Przyjdź Duchu Święty",
        "Potężną moc Jezusa",
        "Objaw wśród nas"
      ]
    },
    {
      "lines": [
        "Przyjdź w mocy i sile",
        "W sprawiedliwości",
        "W pełni pokoju",
        "W pełni radości"
      ]
    },
    {
      "lines": [
        "By głosić czas łaski",
        "I namaszczenia",
        "By zabrać zwątpienie",
        "Z naszych serc"
      ]
    }
  ]
}
