{
  "title": "Chodźcie tu pociąg już jest tuż tuż",
  "verses": [
    {
      "lines": [
        "Chodźcie tu pociąg już",
        "Jest tuż tuż pociąg co",
        "Do Nieba podąża bram.",
        "Każdy kto w Niebie chce",
        "Kiedyś być musi wziąć",
        "I zająć swe miejsce sobie sam."
      ]
    },
    {
      "lines": [
        "Musisz przyjść do Jezusa",
        "By do wejścia prawo mieć",
        "(: Więc postanów,",
        "Czy do nieba jechać chcesz. :)"
      ]
    }
  ]
}
