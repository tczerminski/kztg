{
  "title": "Jezus jest skałą mojego zbawienia",
  "verses": [
    {
      "lines": [
        "Jezus jest skałą",
        "Mojego zbawienia",
        "On jest mą tarczą i mocą mą",
        "Nogi me dłużej",
        "Nie będą się chwiały",
        "Bo Jezus skałą mą jest!"
      ]
    },
    {
      "lines": [
        "Dlatego będę radować się",
        "W Panu mym",
        "Gdyż Bóg mój wysłuchał",
        "Modlitwy mej",
        "O! Jakże wspaniała",
        "Jest pewność ta",
        "Że Jezus Panem mym!"
      ]
    }
  ]
}
