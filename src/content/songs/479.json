{
  "title": "Słowo Boże Twoja broń",
  "verses": [
    {
      "lines": [
        "Słowo Boże – Twoja broń",
        "Słowo Boże to Twój miecz",
        "Do swego bo ku przypasz go",
        "By razić nieprzyjaciela"
      ]
    },
    {
      "lines": [
        "Jezus wodzem armii jest",
        "W szeregi wojska Jego stań",
        "Do boju On sam prowadzi nas",
        "Więc śmiało naprzód idź!"
      ]
    }
  ]
}
