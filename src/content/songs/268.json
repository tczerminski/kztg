{
  "title": "Majestat Twój",
  "verses": [
    {
      "lines": [
        "Majestat Twój",
        "Nie wstrzymał Cię",
        "Korony swej wyrzekłeś się",
        "Wydany byłeś w ręce tych,",
        "Których stworzyłeś"
      ]
    },
    {
      "lines": [
        "Mój grzech,",
        "Mój brud zmazałeś sam",
        "Kiedyś zmarł i zmartwychwstał",
        "Teraz rządzisz Ty",
        "Nad niebo wywyższony"
      ]
    },
    {
      "lines": [
        "Tylko Ciebie Panie",
        "Wielbić chcę",
        "Tylko Ty zmieniłeś",
        "Serce me",
        "Po wieki wieczne",
        "Będę kochać Cię"
      ]
    },
    {
      "lines": [
        "Bo tylko Ty",
        "Zdecydowałeś się",
        "Umrzeć za mnie i wyzwolić mnie",
        "Tobie Panie dzisiaj",
        "Śpiewam w uwielbieniu"
      ]
    }
  ]
}
