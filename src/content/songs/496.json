{
  "title": "Szeroko",
  "verses": [
    {
      "lines": [
        "Szeroko",
        "Twojej łaski rzeka płynie wciąż",
        "Z miłością",
        "Darmo dajesz życia dar",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą"
      ]
    },
    {
      "lines": [
        "Do końca",
        "Ukochałeś Panie kościół swój",
        "Na krzyżu",
        "Z grzechem świata tocząc bój",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą"
      ]
    },
    {
      "lines": [
        "Tak łatwo",
        "Można przyjść do Ciebie łaskę wziąć",
        "Z radością",
        "Darmo dajesz życia dar",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą",
        "Przed Tobą korzę się",
        "Chcę w pełni pojąć miłość Twą"
      ]
    }
  ]
}
