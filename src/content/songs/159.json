{
  "title": "Ja kocham Cię",
  "verses": [
    {
      "lines": [
        "Ja kocham Cię",
        "Panie wznoszę głos",
        "Uwielbiam Cię",
        "Z całej duszy mej",
        "Rozraduj się",
        "Dźwiękiem modlitw mych",
        "Pragnę miłą pieśnią być",
        "W uszach Twych"
      ]
    }
  ]
}
