{
  "title": "Nigdy, nigdy, nigdy jeszcze",
  "verses": [
    {
      "lines": [
        "Nigdy, nigdy, nigdy jeszcze",
        "Tak szczęśliwie i radośnie",
        "Życie nie płynęło dzień po dniu",
        "Nigdy, nigdy, nigdy przedtem",
        "Aż z Jezusem się spotkałem",
        "I naprawdę zaufałem mu",
        "On zabrał smutek z duszy mojej",
        "I wypełnił mnie  pokojem",
        "Teraz śpiewam i raduję się"
      ]
    },
    {
      "lines": [
        "Nigdy, nigdy, nigdy jeszcze",
        "Tak szczęśliwie i radośnie",
        "Życie nie płynęło dzień po dniu"
      ]
    }
  ]
}
