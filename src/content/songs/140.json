{
  "title": "Godzien o godzien nasz Bóg",
  "verses": [
    {
      "lines": [
        "Godzien, o godzien nasz Bóg",
        "Siedzący na tronie",
        "Baranek wśród chwał",
        "Przyjąć wdzięczność, siłę i moc",
        "Honor i chwałę i cześć!"
      ]
    },
    {
      "lines": [
        "(: On Bogiem jest",
        "Od wieków na wieki :)",
        "Amen!"
      ]
    },
    {
      "lines": [
        "Będziemy niezmiennie wciąż trwać",
        "W jedności i prawdzie",
        "Oddając Ci hołd, mądrość,",
        "Wdzięczność, siłę i moc",
        "Honor i chwałę i cześć!"
      ]
    }
  ]
}
