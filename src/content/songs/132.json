{
  "title": "Gdy wokoło straszna burza",
  "verses": [
    {
      "lines": [
        "Gdy wokoło straszna burza",
        "Jezus ze mną w łodzi jest",
        "Mocną ręką trzymasz mnie",
        "Łódka nie wywróci się"
      ]
    },
    {
      "lines": [
        "Gdy wokoło straszna burza",
        "Jezus ze mną w aucie jest",
        "Mocną ręką trzymasz mnie",
        "Auto nie wywróci się"
      ]
    },
    {
      "lines": [
        "Gdy wokoło straszna burza",
        "Jezus ze mną na rowerze jest",
        "Mocną ręką trzymasz mnie",
        "Rower nie wywróci się"
      ]
    }
  ]
}
