{
  "title": "Dziękczynienie",
  "verses": [
    {
      "lines": [
        "Dziękczynienie",
        "Z serc naszych płynie Tobie",
        "Dziękczynienie Tobie Ojcze"
      ]
    },
    {
      "lines": [
        "Gdyby nie Twoja łaska",
        "Nie poznałbym Jezusa",
        "Gdyby nie Twoja łaska",
        "To w ogień pójść bym musiał",
        "Gdyby nie Twoja łaska",
        "Nie miałbym dzisiaj życia",
        "Gdyby nie Twoja łaska",
        "Ojcze, Ojcze"
      ]
    }
  ]
}
