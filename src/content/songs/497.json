{
  "title": "Śmiały bądź, mężny bądź",
  "verses": [
    {
      "lines": [
        "Śmiały bądź, mężny bądź",
        "Bo Twój Bóg i Pan jest z Tobą"
      ]
    },
    {
      "lines": [
        "Więc nie boję się – nie! Nie! Nie!",
        "Nie zachwieję się",
        "(: Zawsze w wierze i zwycięstwie",
        "Chodzić chcę :)",
        "Bo mój Bóg i Pan jest ze mną!"
      ]
    }
  ]
}
