{
  "title": "Wznosimy swój głos w dziękczynieniu",
  "verses": [
    {
      "lines": [
        "Wznosimy swój głos w dziękczynieniu",
        "I ręce wznosimy by wielbić",
        "W ofierze przynosząc owoc warg",
        "Wielbiących Go dziś"
      ]
    },
    {
      "lines": [
        "Barankowi cześć",
        "Święty jest nasz Bóg, nasz Pan",
        "Święty jest nasz Bóg, nasz Pan"
      ]
    }
  ]
}
