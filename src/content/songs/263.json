{
  "title": "Ludu Pański wiedz",
  "verses": [
    {
      "lines": [
        "Ludu Pański wiedz,",
        "Że Pan jedynym Bogiem jest"
      ]
    },
    {
      "lines": [
        "Będziesz kochał Boga",
        "Całym sercem swym!",
        "Będziesz kochał Boga",
        "Z całej duszy swej!",
        "Będziesz kochał Boga",
        "Z całej myśli swej!",
        "Będziesz kochał Boga",
        "Z całej siły swej!"
      ]
    }
  ]
}
