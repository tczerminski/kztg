{
  "title": "Ty zmieniłeś w taniec",
  "verses": [
    {
      "lines": [
        "Ty zmieniłeś w taniec",
        "Moją skargę i płacz",
        "Zdjąłeś mój pokutny wór",
        "Ty zmieniłeś w taniec",
        "Moją skargę i płacz",
        "Odziałeś mnie radością"
      ]
    },
    {
      "lines": [
        "Aby dusza moja chwałę śpiewała Ci",
        "I nie zamilkła",
        "Panie, Boże mój",
        "Już będę Ciebie wysławiać wiecznie"
      ]
    }
  ]
}
