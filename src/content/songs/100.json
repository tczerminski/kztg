{
  "title": "Dotknij, Panie, moich oczu",
  "verses": [
    {
      "lines": [
        "Dotknij Panie moich oczu",
        "Abym przejrzał",
        "Dotknij Panie moich warg",
        "Abym przemówił w uwielbieniu",
        "Dotknij Panie mego serca",
        "I oczyść je",
        "Niech Twój Święty Duch",
        "Dziś ogarnia mnie"
      ]
    }
  ]
}
