{
  "title": "Twoja krew oczyszcza mnie",
  "verses": [
    {
      "lines": [
        "Twoja krew oczyszcza mnie",
        "Nowe życie znajduję w Twojej krwi",
        "Twoja krew przelana jest",
        "By wykupić z grzechu mnie",
        "Obmywa tak"
      ]
    },
    {
      "lines": [
        "Abym bielszym był",
        "Niż śnieg, niż śnieg",
        "Mój Jezu, zmazujesz winy me"
      ]
    }
  ]
}
