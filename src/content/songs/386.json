{
  "title": "Otom ja, Panie mój",
  "verses": [
    {
      "lines": [
        "Otom ja – Panie mój",
        "Pokłon Ci oddaję",
        "W obecności Twej",
        "Przebywać chcę"
      ]
    },
    {
      "lines": [
        "I na pewno nic na świecie",
        "Nie rozłączy nas",
        "Jak cudownie",
        "Jest wielbić Panie Cię"
      ]
    }
  ]
}
