{
  "title": "Póki mego życia",
  "verses": [
    {
      "lines": [
        "Póki mego życia",
        "Panu śpiewać chcę",
        "Grać memu Bogu",
        "Póki życia starczy mi!",
        "Niech Ci będzie Panie",
        "Miła moja pieśń",
        "Będę radować się w Panu –",
        "Bogu mym"
      ]
    },
    {
      "lines": [
        "(: Błogosław duszo moja Panu",
        "Halleluja! :)"
      ]
    }
  ]
}
