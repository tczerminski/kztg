{
  "title": "Ty jesteś życiem mym",
  "verses": [
    {
      "lines": [
        "Ty jesteś życiem mym",
        "Panie tyś życiem mym",
        "Pieśń nową śpiewam Ci",
        "I daję miłość mą",
        "Ty jesteś mocą mą",
        "Tyś jest radością mą",
        "Pieśń nową śpiewam Ci",
        "Przez wszystkie dni"
      ]
    }
  ]
}
