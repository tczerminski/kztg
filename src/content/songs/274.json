{
  "title": "Miłosierny, dobry, święty Bóg",
  "verses": [
    {
      "lines": [
        "Miłosierny, dobry",
        "Święty Bóg",
        "To Ty, to Ty",
        "Dajesz mi pokój i przebaczenie",
        "W ramiona swe bierzesz mnie",
        "Kiedy upadam",
        "Ty mnie podnosisz",
        "W ramionach swych",
        "Trzymasz mnie"
      ]
    }
  ]
}
