{
  "title": "Choćbym nawet szedł przez dolinę",
  "verses": [
    {
      "lines": [
        "Choćbym nawet szedł przez dolinę",
        "Śmierci cienia i zła",
        "Twa miłość wnet zabierze mój strach",
        "I jeśli będę musiał przejść przez burzę",
        "Trudnych chwil w życiu mym",
        "Wiem jesteś blisko, nie cofnę się"
      ]
    },
    {
      "lines": [
        "Zła się nie ulęknę",
        "Bóg jest zawsze ze mną",
        "Gdy mój Bóg jest ze mną",
        "(: Kogo mam się bać :)"
      ]
    },
    {
      "lines": [
        "Wiem, że nie opuścisz mnie",
        "Gdy jest dobrze, gdy jest źle",
        "Wiem, że nie opuścisz mnie",
        "Gdy upadnę, zranię Cię",
        "Wiem, że nie opuścisz mnie",
        "Panie mój nie opuścisz mnie"
      ]
    },
    {
      "lines": [
        "Czuję Twą obecność, gdy przychodzisz",
        "Aby pocieszyć mnie",
        "Nie można z niczym porównać jej",
        "Kiedyś wszystkie troski me przeminą,",
        "Lecz Nim przyjdzie ten dzień",
        "Mój Panie proszę umacniaj mnie"
      ]
    },
    {
      "lines": [
        "Zła się nie ulęknę",
        "Bóg jest zawsze ze mną",
        "Gdy mój Bóg jest ze mną",
        "(: Kogo mam się bać :)"
      ]
    },
    {
      "lines": [
        "Czuję Twą obecność, gdy przychodzisz",
        "Aby pocieszyć mnie",
        "Kiedyś wszystkie troski me przeminą,",
        "Lecz Nim przyjdzie ten dzień",
        "Będę uwielbiać",
        "Będę uwielbiać Cię"
      ]
    }
  ]
}
