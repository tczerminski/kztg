{
  "title": "W Twej obecności",
  "verses": [
    {
      "lines": [
        "W Twej obecności",
        "Twój lud pragnie stać",
        "Wraz z aniołami",
        "(: Woła święty, święty :)"
      ]
    },
    {
      "lines": [
        "Do tronu w niebie",
        "Przychodzi Twój lud",
        "Kłania się Tobie",
        "(: Woła święty, święty :)",
        "Baranek jest"
      ]
    },
    {
      "lines": [
        "Święty, święty, święty",
        "Bóg wszechmogący",
        "On był i jest",
        "I przyjdzie znów"
      ]
    }
  ]
}
