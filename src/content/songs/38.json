{
  "title": "Bóg chce wszystkim ludziom łaskę swoją dać",
  "verses": [
    {
      "lines": [
        "Bóg chce wszystkim",
        "Ludziom łaskę swoją dać",
        "Błogą wieść każdemu",
        "Chce do serca wlać"
      ]
    },
    {
      "lines": [
        "Serca drzwi więc otwórz",
        "I słoneczko wpuść",
        "Życie swoje Panu złóż",
        "(: Wpuść słoneczko z nieba",
        "Wpuść :)"
      ]
    },
    {
      "lines": [
        "Serca drzwi więc otwórz",
        "I słoneczko wpuść",
        "Życie swoje Panu złóż"
      ]
    },
    {
      "lines": [
        "To słoneczko – Chrystus",
        "Przyszedł na ten świat",
        "Lecz nie każdy",
        "Go do serca przyjąć rad"
      ]
    },
    {
      "lines": [
        "Błądzisz w pustce zdań",
        "I chcesz ty wyjście mieć",
        "Wiedz że takich",
        "Chrystus chce do raju wieść"
      ]
    }
  ]
}
