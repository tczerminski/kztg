{
  "title": "Jezus mój dobry jest",
  "verses": [
    {
      "lines": [
        "Jezus mój dobry jest",
        "Dobry jest Jezus mój",
        "Doradca, Boży syn dobry jest"
      ]
    },
    {
      "lines": [
        "Jezus mój wspaniały jest",
        "Wspaniały jest Jezus mój",
        "Książę pokoju,",
        "Wszechmogący Bóg",
        "(: Wspaniały jest :)"
      ]
    }
  ]
}
