{
  "title": "Do Pana ręce podnieśmy swe",
  "verses": [
    {
      "lines": [
        "Do Pana ręce podnieśmy swe",
        "Pląsajmy chwaląc dziś stwórcę",
        "Śpiewajmy (: Panem radujmy się :)",
        "On Bogiem jest"
      ]
    },
    {
      "lines": [
        "Bo sam Pan światłem mym",
        "Skałą i zbawieniem moim",
        "Nie boję się",
        "Lecz Jemu ufać chcę"
      ]
    }
  ]
}
