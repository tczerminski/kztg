{
  "title": "Niech przyjmie chwałę i cześć",
  "verses": [
    {
      "lines": [
        "Niech przyjmie chwałę i cześć",
        "Siedzący na tronie",
        "Błogosławieństwo i moc",
        "Niech weźmie baranek"
      ]
    },
    {
      "lines": [
        "Od wieków na wieki",
        "Niech płynie królowi",
        "Pieśń chwały"
      ]
    }
  ]
}
