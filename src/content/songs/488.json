{
  "title": "Stworzyciel Twój",
  "verses": [
    {
      "lines": [
        "(: Stworzyciel Twój królem królów jest",
        "Wszechmocny wszechmocny :)",
        "Potężny Pan sprawiedliwy Bóg",
        "Z miłości swej na ziemię zszedł",
        "Od wieków jest i na wieki trwa",
        "Król królów Pan panów amen"
      ]
    }
  ]
}
