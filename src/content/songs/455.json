{
  "title": "Radością moją Jezus",
  "verses": [
    {
      "lines": [
        "Radością moją Jezus",
        "Dobry mój Pan"
      ]
    },
    {
      "lines": [
        "Wielkiego Boga znam",
        "On zawsze przy mnie jest",
        "Wielkiego Boga znam",
        "Przy mnie jest, ze mną jest"
      ]
    },
    {
      "lines": [
        "Jego miłość",
        "Ogromna, ogromna, ogromna",
        "Przy niej moja",
        "Taka mała, taka mała, taka mała"
      ]
    }
  ]
}
