{
  "title": "Przyjaciela mam",
  "verses": [
    {
      "lines": [
        "Przyjaciela mam",
        "Co pociesza mnie",
        "Gdy o Jego ramię oprę się",
        "W Nim nadzieję mam",
        "Uleciał strach",
        "On najbliżej jest",
        "Zawsze troszczy się"
      ]
    },
    {
      "lines": [
        "(: Królów król, z nami Bóg :)",
        "(: Jezus :)"
      ]
    }
  ]
