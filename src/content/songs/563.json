{
  "title": "Tylko jedna jest prawda",
  "verses": [
    {
      "lines": [
        "Tylko jedna jest prawda",
        "Tylko jedna jest moc,",
        "Która może odmienić",
        "Nędzny człowieka los"
      ]
    },
    {
      "lines": [
        "Tylko jedna jest miłość",
        "Czysta, świeża jak łza,",
        "Która przyjmie człowieka",
        "Świętą szatę mu da, mu da",
        "Świętą szatę mu da"
      ]
    },
    {
      "lines": [
        "(: Więc wszyscy razem :)",
        "(: Pokłońmy się :)",
        "(: Przed Bożym tronem :)",
        "(: Uniżmy się :)",
        "(: Wznieśmy swe ręce :)",
        "(: Prosząc o dar :)",
        "(: Ojciec tak bardzo :)",
        "Ukochał nas"
      ]
    }
  ]
}
