{
  "title": "Uwielbiamy Cię",
  "verses": [
    {
      "lines": [
        "Uwielbiamy Cię, uwielbiamy Cię,",
        "Uwielbiamy Cię, Panie nasz"
      ]
    },
    {
      "lines": [
        "Najwyższym Bogiem tyś",
        "Na ziemi tej,",
        "Nad wszystkich bogów",
        "Pan większy jest"
      ]
    }
  ]
}
