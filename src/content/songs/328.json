{
  "title": "Niech Pan Ci błogosławi i strzeże",
  "verses": [
    {
      "lines": [
        "Niech Pan Cię błogosławi",
        "I strzeże",
        "My błogosławimy Cię też!",
        "Niech Pan Cię błogosławi",
        "I strzeże",
        "W imieniu Pana błogosławię Cię"
      ]
    },
    {
      "lines": [
        "Niech twarz swą",
        "Rozjaśni nad Tobą",
        "I miłościw będzie Ci",
        "Oblicze swe zwróci ku Tobie",
        "I pokój Ci da"
      ]
    }
  ]
}
