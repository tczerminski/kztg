{
  "title": "Ofiarowujemy Ci",
  "verses": [
    {
      "lines": [
        "Ofiarowujemy Ci",
        "Chwałę i cześć – Panie nasz"
      ]
    },
    {
      "lines": [
        "I w ofierze składamy Ci",
        "Dzięki i wdzięczność –",
        "Boś dobry jest",
        "I w ofierze składamy Ci",
        "Radosny nasz śpiew"
      ]
    }
  ]
}
