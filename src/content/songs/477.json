{
  "title": "Skosztuj i zobacz",
  "verses": [
    {
      "lines": [
        "Skosztuj i zobacz,",
        "Że tak dobry jest mój Pan.",
        "Gdy szukasz",
        "On na pewno odpowiedź da Ci dziś"
      ]
    },
    {
      "lines": [
        "(: Wielki jest mój Pan :) x3",
        "Godzien wszelkiej chwały"
      ]
    },
    {
      "lines": [
        "(: Dobry jest mój Pan :) x3",
        "Godzien wszelkiej chwały"
      ]
    },
    {
      "lines": [
        "(: Święty jest mój Pan :) x3",
        "Godzien wszelkiej chwały"
      ]
    }
  ]
}
