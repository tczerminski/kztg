{
  "title": "Jak piękne są",
  "verses": [
    {
      "lines": [
        "Jak piękne są",
        "Na górach nogi tego",
        "Który zwiastuje",
        "Radosną wieść!"
      ]
    },
    {
      "lines": [
        "Ogłasza pokój,",
        "Miłość i zbawienie",
        "Panem Bóg! Królem Bóg!",
        "(: Panem Bóg! Królem Bóg! :)"
      ]
    }
  ]
}
