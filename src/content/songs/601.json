{
  "title": "W sercu mym Boże rządź",
  "verses": [
    {
      "lines": [
        "W sercu mym",
        "Boże rządź w sercu mym",
        "Jako król",
        "W sercu mym zawsze bądź"
      ]
    },
    {
      "lines": [
        "Niech królestwo Twe",
        "We mnie ziści się",
        "Twą wolę pełnić chcę",
        "W sercu moim rządź"
      ]
    }
  ]
}
