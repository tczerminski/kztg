{
  "title": "Godzien jesteś Panie i Boże",
  "verses": [
    {
      "lines": [
        "Godzien jesteś",
        "Godzien jesteś",
        "Panie i Boże nasz",
        "Godzien jesteś",
        "Przyjąć chwałę",
        "Chwałę, cześć i moc!"
      ]
    },
    {
      "lines": [
        "Ponieważ Ty wszystko",
        "Stworzyłeś w swej mocy!",
        "Wszystko stworzyłeś Ty sam!",
        "I z woli Twojej",
        "Zostało stworzone",
        "Godzien jesteś wziąć cześć!"
      ]
    }
  ]
}
