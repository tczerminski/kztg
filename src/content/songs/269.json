{
  "title": "Majestatu król",
  "verses": [
    {
      "lines": [
        "Majestatu król",
        "Zwycięski chwały Bóg",
        "Ziemio raduj się",
        "Ziemio raduj się"
      ]
    },
    {
      "lines": [
        "Odziany w blask i moc",
        "Rozprasza światłem mrok",
        "On drży na Jego głos",
        "On drży na Jego głos"
      ]
    },
    {
      "lines": [
        "Wielki jest Bóg",
        "Śpiewaj to jak wielki jest Bóg",
        "Wszyscy ujrzą to",
        "Jak wielki jest Bóg"
      ]
    },
    {
      "lines": [
        "Od wieków wiecznie trwa",
        "W swych dłoniach trzyma czas",
        "Początkiem końcem On",
        "Początkiem końcem On"
      ]
    },
    {
      "lines": [
        "Trójjedyny Bóg",
        "Ojciec syn i Duch",
        "Barankiem jest i lwem",
        "Barankiem jest i lwem"
      ]
    },
    {
      "lines": [
        "Na wieki godzien jest",
        "Przyjąć chwałę moc i cześć",
        "Ogłaszać chcę",
        "Jak wielki jest Bóg"
      ]
    }
  ]
}
