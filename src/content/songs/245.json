{
  "title": "Kiedy wchodzę w Twą obecność",
  "verses": [
    {
      "lines": [
        "Kiedy wchodzę w Twą obecność",
        "Poprzez bramy chwał,",
        "Do Twojej świątyni",
        "Aż staniemy twarzą w twarz",
        "Kiedy patrzę w Twe oblicze",
        "Widzę pełnię łaski Twej",
        "Klęcząc pragnę powiedzieć Ci, że"
      ]
    },
    {
      "lines": [
        "Wspaniałym Bogiem jesteś",
        "Panie mój",
        "Potężnym Bogiem jesteś",
        "Abba Ojcze",
        "Jesteś godzien wszelkiej chwały",
        "Tobie daję życie me",
        "Bo wspaniałym Bogiem jesteś",
        "Panie mój"
      ]
    }
  ]
}
