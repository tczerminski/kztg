{
  "title": "W mym sercu mieszka król",
  "verses": [
    {
      "lines": [
        "W mym sercu mieszka król",
        "(: A Jego flagą radość jest :)",
        "W mym sercu mieszka król",
        "A Jego flagą radość jest",
        "Którą widać",
