{
  "title": "Radość wypełnia duszę mą",
  "verses": [
    {
      "lines": [
        "Radość wypełnia duszę mą",
        "Radość wypełnia mnie",
        "Źródło wody żywej jest w sercu mym"
      ]
    },
    {
      "lines": [
        "Radość wypełnia duszę mą",
        "Radość wypełnia mnie",
        "Bo imię me w niebie wpisane jest",
        "Alleluja!"
      ]
    }
  ]
}
