{
  "title": "Boże Ojcze chcę wywyższać Cię dziś",
  "verses": [
    {
      "lines": [
        "(: Boże Ojcze",
        "Chcę wywyższać Cię dziś :)",
        "Jam Twoim jest dziełem",
        "Co złe – we mnie przemień",
        "Boże Ojcze",
        "Chcę wywyższać Cię dziś!"
      ]
    },
    {
      "lines": [
        "(: Boży Synu",
        "Chcę uwielbiać Cię dziś :)",
        "Za śmierć Twoją Panie,",
        "Za Twe zmartwychwstanie",
        "Boży Synu",
        "Chcę uwielbiać Cię dziś"
      ]
    },
    {
      "lines": [
        "(: Duchu Święty",
        "Racz wypełnić dziś mnie :)",
        "Bądź ze mną i kieruj",
        "Zaprowadź do celu",
        "Duchu Święty",
        "Racz wypełnić i mnie!"
      ]
    }
  ]
}
