{
  "title": "Chwalmy Go Pan w majestacie swym",
  "verses": [
    {
      "lines": [
        "Chwalmy Go!",
        "Pan w majestacie swym",
        "Jezus godzien wszelkiej",
        "Chwały, mocy i czci"
      ]
    },
    {
      "lines": [
        "Chwalmy Go! Złóżmy korony swe",
        "Pan nasz na tron",
        "Wstąpił wśród chwał",
        "Wszyscy Go czczą"
      ]
    },
    {
      "lines": [
        "Bowiem Bóg wywyższył sam",
        "Imię Jezusa",
        "Wszelki twór niech wyzna więc",
        "Że Jezus to Pan!"
      ]
    },
    {
      "lines": [
        "Chwalmy Go!",
        "Pan w majestacie swym",
        "Jezus co zmarł",
        "Teraz wśród chwał",
        "To królów król!"
      ]
    }
  ]
}
