{
  "title": "Twe drogi są najlepsze",
  "verses": [
    {
      "lines": [
        "Twe drogi są najlepsze",
        "Najlepsze dla mnie są",
        "Ty Panie wiesz najlepiej",
        "Co dla mnie dobre jest"
      ]
    },
    {
      "lines": [
        "I zawsze troszczysz się",
        "Bo bardzo kochasz mnie",
        "I zawsze troszczysz się",
        "Bo bardzo kochasz mnie"
      ]
    }
  ]
}
