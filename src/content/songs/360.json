{
  "title": "Oczyść serce me",
  "verses": [
    {
      "lines": [
        "Oczyść serce me,",
        "Chcę jak złoto lśnić",
        "I jak czyste srebro",
        "Oczyść serce me",
        "Chcę czystego złota",
        "Blaskiem lśnić"
      ]
    },
    {
      "lines": [
        "Zstąp ogniu, zstąp",
        "Przyjdź oczyść serce me",
        "Pragnę być święty,",
        "Tobie oddany Panie",
        "Chcę zawsze być święty",
        "Tobie mój mistrzu na zawsze oddany",
        "Gotów by służyć Ci"
      ]
    },
    {
      "lines": [
        "Oczyść serce me,",
        "Obmyj swoją krwią",
        "Spraw, bym mógł być święty.",
        "Oczyść serce me,",
        "Z najtajniejszych grzechów",
        "Oczyść je"
      ]
    }
  ]
}
