{
  "title": "Ty jesteś treścią mej pieśni",
  "verses": [
    {
      "lines": [
        "Ty jesteś treścią mej pieśni",
        "Ty jesteś pieśnią mą dziś",
        "Tyś jest melodią mą",
        "Tyś jest harmonią mą",
        "Cześć Twa",
        "Niech wznosi się wzwyż"
      ]
    },
    {
      "lines": [
        "Tyś jest wszechmocny Bóg",
        "Ty jesteś panów Pan",
        "Ty jesteś królów król",
        "(: Teraz znów śpiewam Ci",
        "Pieśń, którą Ty dałeś mi",
        "Ty jesteś pieśnią mą dziś :)"
      ]
    }
  ]
}
