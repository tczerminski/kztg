{
  "title": "Tobie chór aniołów",
  "verses": [
    {
      "lines": [
        "Tobie chór aniołów",
        "Śpiewa nową pieśń",
        "Chwała barankowi"
      ]
    },
    {
      "lines": [
        "Alleluja, alleluja, alleluja",
        "Chwała i cześć"
      ]
    },
    {
      "lines": [
        "Moje serce śpiewa Tobie",
        "Nową pieśń",
        "Chwała barankowi"
      ]
    }
  ]
}
