{
  "title": "Jezu tyś królem jest",
  "verses": [
    {
      "lines": [
        "Jezu tyś królem jest",
        "Tobie wciąż śpiewać chcę",
        "Pragnę ciągle wielbić Cię",
        "Tyś zawsze doskonały jest"
      ]
    },
    {
      "lines": [
        "Jezu tyś Panem mym",
        "Będę posłuszny Ci",
        "Przyjdź królestwo Twoje, przyjdź",
        "Niech Twa wola stanie się"
      ]
    },
    {
      "lines": [
        "Chwała barankowi cześć",
        "Zabierz mnie do ziemi swej",
        "Zwyciężymy z Tobą dziś",
        "Ogłaszając królem Cię",
        "(: Cześć, cześć tyś z judy lew",
        "Potężny jesteś Ty :)"
      ]
    }
  ]
}
