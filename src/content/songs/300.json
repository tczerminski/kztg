{
  "title": "Nasz Bóg jest większy (Boże u Ciebie jest moc)",
  "verses": [
    {
      "lines": [
        "Boże u Ciebie jest moc",
        "Ślepym przywracasz ich wzrok",
        "Nic nie dorówna Panie Ci",
        "W ciemności światło Twe lśni",
        "Z prochu powstaje by żyć",
        "Nikt nie dorówna Panie Ci"
      ]
    },
    {
      "lines": [
        "Nasz Bóg jest większy najpotężniejszy",
        "Nic nie jest w stanie dorównać jemu",
        "Nasz Bóg uzdrawia Bóg wszechmogący",
        "Nasz Bóg nasz Bóg"
      ]
    },
    {
      "lines": [
        "I jeśli Bóg jest z nami",
        "To kto nas dziś zatrzyma",
        "I jeśli Bóg jest z nami",
        "To kto przeciwko nam"
      ]
    }
  ]
}
