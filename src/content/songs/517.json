{
  "title": "Święty, święty jest nasz Pan",
  "verses": [
    {
      "lines": [
        "Święty, święty jest nasz Pan",
        "Wszechmogący Bóg",
        "Niebo i ziemia",
        "Pełne są Jego czci"
      ]
    },
    {
      "lines": [
        "Hosanna, hosanna, hosanna",
        "Na wysokościach"
      ]
    }
  ]
}
