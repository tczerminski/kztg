{
  "title": "Cieszę się wciąż, tyś radość mi dał",
  "verses": [
    {
      "lines": [
        "Cieszę się wciąż",
        "Tyś radość mi dał",
        "Miłość nad miód co wina ma smak",
        "Uchwyć mocno mnie",
        "Pobiegnijmy razem",
        "Cieszę się wciąż",
        "Tyś radość mi dał"
      ]
    }
  ]
}
