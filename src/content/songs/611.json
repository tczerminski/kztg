{
  "title": "Wejdźmy do Jego bram z dziękczynieniem",
  "verses": [
    {
      "lines": [
        "Wejdźmy do Jego bram",
        "Z dziękczynieniem",
        "U Jego tronu oddajmy cześć",
        "Wejdźmy do Jego bram",
        "Z uwielbieniem",
        "Radosną Bogu śpiewajmy pieśń"
      ]
    },
    {
      "lines": [
        "Rozraduj się w Nim",
        "Twym stworzycielu",
        "Rozraduj się w Nim",
        "Światłości Twej",
        "Rozraduj się w Nim",
        "Twym zbawicielu",
        "Rozraduj się w Nim",
        "I wywyższać Go chciej"
      ]
    },
    {
      "lines": [
        "Halleluja…"
      ]
    }
  ]
}
