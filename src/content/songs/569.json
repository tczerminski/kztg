{
  "title": "Tyś Bogiem mym (kocham Cię, Jezu)",
  "verses": [
    {
      "lines": [
        "Tyś Bogiem mym",
        "(Kocham Cię Jezu)",
        "Tyś królem mym",
        "Tyś moim mistrzem",
        "(Kochać wciąż chcę)",
        "Tyś wszystkim mi",
        "Tyś Panem mym",
        "(Jesteś mym mistrzem)",
        "Dlatego śpiewam Ci:",
        "Alleluja! Alleluja!",
        "(Uwielbiam Cię! Uwielbiam Cię!)"
      ]
    }
  ]
}
