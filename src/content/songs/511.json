{
  "title": "Święta krew, Jezusa krew",
  "verses": [
    {
      "lines": [
        "Święta krew Jezusa krew",
        "Przelała się za mój grzech",
        "Cudna krew baranka krew",
        "Oczyszcza dziś serce me"
      ]
    },
    {
      "lines": [
        "O za mnie tam",
        "Chrystus Pan",
        "Cierpiał krzyż",
        "Haniebnie zmarł",
        "Bym poznał moc",
        "Tej cudnej krwi"
      ]
    }
  ]
}
