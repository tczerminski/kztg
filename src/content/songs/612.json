{
  "title": "Weselić się będzie",
  "verses": [
    {
      "lines": [
        "Weselić się będzie",
        "Z pląsaniem panna",
        "Młodzieńcy, starcy społem",
        "Laj, laj, laj…",
        "(: I w radość zamienię ich płacz :)",
        "(: Ich wybawieniem w smutku",
        "Będzie radość :)"
      ]
    }
  ]
}
