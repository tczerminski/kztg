{
  "title": "Jezus powrócić wkrótce ma",
  "verses": [
    {
      "lines": [
        "Jezus powrócić wkrótce ma",
        "Może przyjść każdego dnia",
        "Jezus powróci wkrótce wiem",
        "W tym Duch Święty",
        "Upewnia mnie"
      ]
    },
    {
      "lines": [
        "Więc chwalmy Go",
        "Niech brzmi",
        "Halleluja! Amen! (Amen!)",
        "Więc chwalmy Go",
        "Zbliża się wspaniały dzień"
      ]
    }
  ]
}
