{
  "title": "Jam jest Twój Bóg",
  "verses": [
    {
      "lines": [
        "Jam jest Twój Bóg",
        "Uzdrawiam Cię",
        "Ja jestem Twym lekarzem",
        "Posyłam słowo i uzdrawiam Cię",
        "Ja jestem Twym lekarzem!"
      ]
    },
    {
      "lines": [
        "Tyś Bogiem mym",
        "Uzdrawiasz mnie",
        "Tyś Panem mym lekarzem",
        "Posyłasz słowo",
        "I uzdrawiasz mnie",
        "Ty jesteś mym lekarzem"
      ]
    }
  ]
}
