{
  "title": "Są chwile, jak ta",
  "verses": [
    {
      "lines": [
        "Są chwile, jak ta",
        "Gdy śpiewam Ci pieśń",
        "Miłości mej pieśń zbawicielu",
        "Są chwile, gdy chcę",
        "Zaśpiewać Ci pieśń",
        "Pieśń chwały, miłości i czci"
      ]
    },
    {
      "lines": [
        "(: Jezu mój kocham Cię :)",
        "Zawsze kochać chcę",
        "Tyś mój Bóg i Pan!"
      ]
    }
  ]
}
