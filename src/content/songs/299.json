{
  "title": "Nasz Bóg jest wielki (z ognia ich wyratowałeś)",
  "verses": [
    {
      "lines": [
        "Z ognia ich wyratowałeś",
        "Z paszcz lwiej Jego wyratowałeś",
        "Któż jest jak Ty tylko Ty",
        "Ręką po ścianie pisałeś",
        "Snu wyjaśnienie mu dałeś",
        "Któż jest jak Ty tylko Ty"
      ]
    },
    {
      "lines": [
        "Nasz Bóg jest wielki",
        "Nasz Bóg jest silny",
        "Boże nikt inny nie równa się z Tobą",
        "Nasz Bóg uzdrawia jest wszechmogący",
        "Nasz Bóg nasz Bóg"
      ]
    },
    {
      "lines": [
        "Zmartwione serca pocieszasz",
        "Odwagę codziennie dajesz",
        "Któż jest jak Ty tylko Ty"
      ]
    },
    {
      "lines": [
        "Jeśli nasz Bóg jest z nami",
        "Już nic nas nie za trzyma",
        "Jeśli nasz Bóg jest z nami",
        "Już nic nas nie zatrzyma"
      ]
    }
  ]
}
