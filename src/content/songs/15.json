{
  "title": "Będę błogosławić Panu",
  "verses": [
    {
      "lines": [
        "Będę błogosławić Panu",
        "Aż do końca dni",
        "Chwała Jemu niech ciągle",
        "Wypływa z mych ust"
      ]
    },
    {
      "lines": [
        "Podnieśmy głos",
        "I chwalmy Go",
        "I chciejmy razem",
        "Imię Jego czcić."
      ]
    }
  ]
}
