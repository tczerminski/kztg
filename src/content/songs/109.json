{
  "title": "Dzięki Ci, Boże mój",
  "verses": [
    {
      "lines": [
        "Dzięki Ci Boże mój",
        "Za to co w Jezusie dałeś mi",
        "Pokój radość i zbawienie",
        "Uwolnienie z grzechów mych!",
        "Dzięki Ci Panie mój",
        "Dusza moja wielbi Cię",
        "Tak jak jeleń pragnie wód",
        "Tak ja z Tobą pragnę być!"
      ]
    }
  ]
}
