{
  "title": "Jezus zwyciężył to wykonało się",
  "verses": [
    {
      "lines": [
        "Jezus zwyciężył – to wykonało się",
        "Szatan pokonany",
        "Jezus złamał śmierci moc",
        "Jezus jest Panem – o! Halleluja!",
        "Po wieczne czasy",
        "Królem królów jest!"
      ]
    },
    {
      "lines": [
        "(: Jezus jest Panem :) x6",
        "On jest Panem ziemi tej"
      ]
    },
    {
      "lines": [
        "(: Halleluja :)"
      ]
    },
    {
      "lines": [
        "Jezus zwyciężył",
        "Niech każdy o tym wie,",
        "Że szatan pokonany",
        "Jezus złamał śmierci moc",
        "Jezus jest Panem – o! Halleluja!",
        "Po wieczne czasy –",
        "Królem królów jest!"
      ]
    }
  ]
}
