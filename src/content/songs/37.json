{
  "title": "Boży pokój tak jak rzeka",
  "verses": [
    {
      "lines": [
        "Boży pokój tak jak rzeka",
        "Płynie z głębi naszych serc",
        "I przepływa przez pustynię",
        "Uwalniając więźniów z pęt"
      ]
    },
    {
      "lines": [
        "Boża łaska tak jak rzeka",
        "Płynie z głębi naszych serc",
        "I przepływa przez pustynię",
        "Uwalniając więźniów z pęt"
      ]
    },
    {
      "lines": [
        "Boża miłość tak jak rzeka",
        "Płynie z głębi naszych serc",
        "I przepływa przez pustynię",
        "Uwalniając więźniów z pęt"
      ]
    }
  ]
}
