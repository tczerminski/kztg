{
  "title": "Uderzą na miasto",
  "verses": [
    {
      "lines": [
        "Uderzą na miasto",
        "Zdobędą ten mur",
        "Tak liczne zastępy",
        "Posłuszne mu są"
      ]
    },
    {
      "lines": [
        "To Pan wydaje swój głos",
        "Przed wojskiem swym"
      ]
    },
    {
      "lines": [
        "Drużyno syjonu, syjonu",
        "Stań rzędem na górze mej świętej",
        "Drużyno syjonu, syjonu",
        "Na górze mej stań!"
      ]
    }
  ]
}
