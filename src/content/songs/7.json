{
  "title": "Alleluja – miłość Twa",
  "verses": [
    {
      "lines": [
        "Alleluja! Miłość Twa",
        "Jak blask słońca",
        "Nad nami wciąż trwa",
        "Alleluja! Niech bija dziś dzwony",
        "Niech wielbi Cię cały świat,",
        "Alleluja!"
      ]
    },
    {
      "lines": [
        "Alleluja! Płynie pieśń",
        "Więc wraz z nami",
        "Ku niebu ją wznieś",
        "Alleluja! Niech biją dziś dzwony",
        "Niech wielbi Cię cały świat,",
        "Alleluja!"
      ]
    }
  ]
}
