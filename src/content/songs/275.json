{
  "title": "Miłość bożą w sercu swym",
  "verses": [
    {
      "lines": [
        "Miłość bożą w sercu swym",
        "Dzisiaj mam",
        "Tą miłością coraz bardziej",
        "Kocham Cię",
        "W Tobie widzę też",
        "Wspaniałość króla chwał",
        "Bo miłość bożą w sercu swym",
        "Dzisiaj mam"
      ]
    }
  ]
}
