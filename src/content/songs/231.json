{
  "title": "Jezus to król dziś Go wywyższamy",
  "verses": [
    {
      "lines": [
        "Jezus to król!",
        "Dziś Go wywyższamy",
        "Jezus to król!",
        "Uwielbiamy go"
      ]
    },
    {
      "lines": [
        "Nasze pieśni, nasze życie",
        "Oddajemy Jezusowi",
        "La, la, la, la laj…"
      ]
    }
  ]
}
