{
  "title": "Choćbym nawet upadł",
  "verses": [
    {
      "lines": [
        "Choćbym nawet upadł",
        "I zabrakło mi sił by wstać"
      ]
    },
    {
      "lines": [
        "Nie, nie, nie oskarżysz mnie",
        "Nie, nie, nie oskarżysz mnie",
        "Choćbym nawet upadł",
        "I zabrakło mi sił by wstać"
      ]
    },
    {
      "lines": [
        "Nie będę słuchał diabła kłamstw",
        "On po to przyszedł, by kłamać i kraść",
        "Nie będę słuchać Jego słów",
        "Nie ma w nich prawdy",
        "Nie wierzcie mu"
      ]
    },
    {
      "lines": [
        "Ciebie posłucham Panie mój",
        "Tak, Twoje słowo – mocny mur",
        "Ciebie posłucham",
        "Panie mój",
        "Raczej pocieszy mnie Twój Duch"
      ]
    },
    {
      "lines": [
        "Choćbym znowu się",
        "Zawieruszył w ciemny kąt",
        "Choćbym zabłądził znowu",
        "Gdzieś daleko stąd"
      ]
    },
    {
      "lines": [
        "Nie, nie, nie oskarżysz mnie",
        "Nie, nie, nie oskarżysz mnie",
        "Choćbym zabłądził znowu",
        "Gdzieś daleko stąd"
      ]
    }
  ]
}
