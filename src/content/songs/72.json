{
  "title": "Chwała! Chwała! Król jest godzien czci",
  "verses": [
    {
      "lines": [
        "Chwała! Chwała!",
        "Król jest godzien czci"
      ]
    },
    {
      "lines": [
        "Kto jest tym królem chwały?",
        "Tym królem – Chrystus Pan!",
        "Wywyższony ponad wszystko",
        "Na ziemi jest!",
        "Jego imię głośno brzmi!"
      ]
    }
  ]
}
