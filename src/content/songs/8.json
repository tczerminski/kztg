{
  "title": "Alleluja – pójdźmy do miasta",
  "verses": [
    {
      "lines": [
        "(: Alleluja :)",
        "Amen"
      ]
    },
    {
      "lines": [
        "Pójdźmy do miasta,",
        "Gdzie Baranek światłem jest.",
        "Czeka tam Pan, nasz Pan",
        "Skosztuj z drzewa życia",
        "Wody z rzeki życia pij.",
        "Pójdźmy tam, gdzie jest Pan, nasz Pan."
      ]
    }
  ]
}
