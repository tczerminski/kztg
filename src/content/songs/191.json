{
  "title": "Jesteśmy narodem zwycięzców",
  "verses": [
    {
      "lines": [
        "Jesteśmy narodem zwycięzców",
        "Ludźmi honoru, świętymi w Nim",
        "Jesteśmy narodem zwycięzców",
        "Bierzemy dziedzictwo swe"
      ]
    },
    {
      "lines": [
        "Pan podnosi sztandar swój,",
        "Czerwony jest od baranka krwi,",
        "Wznosi go ponad ludem swym",
        "Biegniemy więc odważnie jak lwy."
      ]
    }
  ]
}
