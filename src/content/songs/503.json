{
  "title": "Śpiewaj Panu pieśń nową",
  "verses": [
    {
      "lines": [
        "Śpiewaj Panu dziś pieśń nową",
        "Śpiewaj Panu dziś cała ziemio",
        "Śpiewaj Panu cała ziemio",
        "Śpiewaj Panu nową pieśń"
      ]
    },
    {
      "lines": [
        "Gdyż Pan wielki jest",
        "I godzien wszelkiej czci",
        "On wielki jest",
        "I godzien by Go czcić"
      ]
    }
  ]
}
