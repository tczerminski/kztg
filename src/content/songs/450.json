{
  "title": "Przyjdź, dotknij mnie",
  "verses": [
    {
      "lines": [
        "Przyjdź, dotknij mnie",
        "Pragnę Twej mocy",
        "Przyjdź, dotknij mnie"
      ]
    },
    {
      "lines": [
        "Wszystko to, co mam",
        "Pragnę Tobie dać",
        "Mój zbawco,",
        "Mój Panie i zbawco"
      ]
    }
  ]
}
