{
  "title": "Szczęśliwi ludzie są to ci",
  "verses": [
    {
      "lines": [
        "Szczęśliwi ludzie są to ci",
        "Których Panem jest Bóg"
      ]
    },
    {
      "lines": [
        "Wcześnie szukać będą go",
        "Służyć mu do końca dni",
        "Będą ufać Jezusowi",
        "Nie zawiedzie ich",
        "Będą ufać Jezusowi",
        "Wskaże drogę im"
      ]
    }
  ]
}
