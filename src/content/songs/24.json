{
  "title": "Błogosławmy imię Pana chwał",
  "verses": [
    {
      "lines": [
        "Błogosławmy imię Pana chwał",
        "Bo On godzien",
        "Wszelkiej chwały i czci",
        "Dziś wznosimy ręce swe",
        "Do Pana chwał",
        "W pieśniach",
        "Błogosławiąc go",
        "Błogosławiąc go",
        "Błogosławiąc imię Pana chwał"
      ]
    }
  ]
}
