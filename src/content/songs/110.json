{
  "title": "Dzięki Jezu, drogi Jezu",
  "verses": [
    {
      "lines": [
        "Dzięki Jezu! Drogi Jezu",
        "Dzięki Ci, że kochasz mnie"
      ]
    },
    {
      "lines": [
        "Na golgocie za mnie zmarłeś",
        "Dzięki Ci, że kochasz mnie"
      ]
    },
    {
      "lines": [
        "Zmartwychwstałeś!",
        "Żyjesz we mnie",
        "Dzięki Ci, że kochasz mnie"
      ]
    },
    {
      "lines": [
        "Wkrótce przyjdziesz,",
        "Stąd mnie weźmiesz",
        "Dzięki Ci, że kochasz mnie"
      ]
    },
    {
      "lines": [
        "Alleluja! Alleluja!",
        "Dzięki Ci, że kochasz mnie"
      ]
    }
  ]
}
