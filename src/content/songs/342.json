{
  "title": "Nowe stworzenie to jestem ja",
  "verses": [
    {
      "lines": [
        "Nowe stworzenie –",
        "To jestem ja",
        "Stare przeminęło –",
        "Nowe życie mam",
        "Wielkim zwycięzcą",
        "Już jestem ja",
        "Nowe stworzenie",
        "Nowe życie mam"
      ]
    }
  ]
}
