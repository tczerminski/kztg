{
  "title": "Światłością masz dla świata być",
  "verses": [
    {
      "lines": [
        "Światłością",
        "Masz dla świata być"
      ]
    },
    {
      "lines": [
        "Boża chwała jest",
        "Wśród Jego ludu",
        "Boża chwała jest wśród nas",
        "Pan przebywa w chwałach",
        "Swego ludu dziś!"
      ]
    }
  ]
}
