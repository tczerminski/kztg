{
  "title": "Jak wdzięczne są przybytki Twoje",
  "verses": [
    {
      "lines": [
        "Jak wdzięczne są",
        "Przybytki Twoje",
        "Tęskni i pragnie ich",
        "Dusza ma",
        "Me serce i ciało z radością",
        "Dziś krzyczą w głos",
        "Tyś Panem mym i mym Bogiem"
      ]
    }
  ]
}
