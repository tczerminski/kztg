{
  "title": "Ojcu naszemu oddajmy dziś cześć",
  "verses": [
    {
      "lines": [
        "Ojcu naszemu oddajmy dziś cześć",
        "Bogu wszechmogącemu",
        "Temu jedynie, co godzien czci jest",
        "Alleluja"
      ]
    },
    {
      "lines": [
        "Alleluja"
      ]
    },
    {
      "lines": [
        "Sztandar Jezusa podnieśmy dziś wzwyż",
        "Majestat Jego czcijmy",
        "Temu jedynie, co godzien czci jest",
        "Alleluja"
      ]
    },
    {
      "lines": [
        "Chwalmy Go za to, że Ducha nam dał",
        "Który napełnia nas",
        "Temu jedynie, co godzien czci jest",
        "Alleluja"
      ]
    }
  ]
}
