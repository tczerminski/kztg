{
  "title": "Zbliż się",
  "verses": [
    {
      "lines": [
        "Zbliż się, zbliż się dziś",
        "On przyszedł tu dla Ciebie",
        "Zobacz – już wyciąga dłoń",
        "Duchu Boży prosimy Cię"
      ]
    },
    {
      "lines": [
        "(: Przechadzaj się :) x3",
        "Wśród nas Duchu Boży",
        "(: Ogarnij nas :) x3",
        "Miłością Duchu Boży",
        "(: Napełnij nas :) x3",
        "Swą mocą Duchu Boży"
      ]
    }
  ]
}
