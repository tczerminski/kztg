{
  "title": "Panem jest",
  "verses": [
    {
      "lines": [
        "Panem jest! Panem jest!",
        "Jezus Chrystus dzisiaj",
        "Moim Panem jest",
        "Klęknij przed nim, wyznaj też,",
        "Że On Twoim Panem jest,",
        "Że Jezus Panem jest"
      ]
    },
    {
      "lines": [
        "Królem jest! Królem jest!",
        "Jezus Chrystus dzisiaj",
        "Moim królem jest",
        "Klęknij przed nim, wyznaj też,",
        "Że On Twoim królem jest,",
        "Że Jezus królem jest"
      ]
    },
    {
      "lines": [
        "Bogiem jest! Bogiem jest!",
        "Jezus Chrystus dzisiaj",
        "Moim Bogiem jest",
        "Klęknij przed nim, wyznaj też,",
        "Że On Twoim Bogiem jest,",
        "Że Jezus Bogiem jest"
      ]
    }
  ]
}
