{
  "title": "Bóg dobry jest i na wieki Jego łaska trwa",
  "verses": [
    {
      "lines": [
        "Bóg dobry jest",
        "I na wieki Jego łaska trwa"
      ]
    },
    {
      "lines": [
        "On odpuszcza moje winy,",
        "Leczy wszystkie moje choroby"
      ]
    },
    {
      "lines": [
        "Jedynemu prawdziwemu Bogu chwała",
        "Jedynemu prawdziwemu Bogu chwała",
        "Chwała, chwała, chwała,",
        "Chwała Ci"
      ]
    }
  ]
}
