{
  "title": "Pan wywyższony, nasz król wywyższony",
  "verses": [
    {
      "lines": [
        "Pan wywyższony",
        "Nasz król wywyższony",
        "Wśród chwał – uwielbiajmy Go",
        "Pan wywyższony",
        "Nasz król wywyższony",
        "Oddajmy jemu cześć!"
      ]
    },
    {
      "lines": [
        "Królem jest Pan!",
        "Ta prawda na wieki trwa",
        "Niebo i ziemio",
        "Radujcie się Jego imieniem",
        "Pan wywyższony",
        "Nasz król wywyższony",
        "Wśród chwał"
      ]
    }
  ]
}
