{
  "title": "Zmartwychwstał Pan, zwycięstwa chwałą",
  "verses": [
    {
      "lines": [
        "Zmartwychwstał Pan",
        "Zwycięstwa chwałą niebo brzmi",
        "Któż tak jak On",
        "Majestatu blaskiem lśni"
      ]
    },
    {
      "lines": [
        "Baranek królem jest",
        "Najwyższy zajął tron",
        "W pokorze chylę się",
        "Z radością składam hołd"
      ]
    },
    {
      "lines": [
        "Rozgłosić chcę radosną",
        "Zmartwychwstania wieść",
        "Na krzyżu Pan",
        "Przezwyciężył grzech i śmierć"
      ]
    }
  ]
}
