{
  "title": "Ogłaszamy Pański dzień",
  "verses": [
    {
      "lines": [
        "Ogłaszamy Pański dzień",
        "Wielki dzień Jego chwały",
        "Że nasz Bóg jest wspaniały",
        "Wszędzie głosimy",
        "Pragnąc Jego przyjścia"
      ]
    },
    {
      "lines": [
        "Sztandar Jego niech dziś",
        "Wznosi się coraz wyżej",
        "Ogłaszamy Pański dzień",
        "Jego imię niech głośno brzmi!"
      ]
    }
  ]
}
