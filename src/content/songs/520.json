{
  "title": "Święty, wielki, mocny",
  "verses": [
    {
      "lines": [
        "Święty, wielki, mocny",
        "Jest Boży syn",
        "Święty, wielki, mocny",
        "Jest Chrystus Pan"
      ]
    },
    {
      "lines": [
        "Pokłońmy więc nasze czoła",
        "W pokornej czci wielbiąc go",
        "Myśmy ludem żywego Boga",
        "Mocno trzyma nas ręką swą"
      ]
    },
    {
      "lines": [
        "Chwalimy Ciebie nasz Panie",
        "Zginając kolana swe",
        "Ogłaszamy Twoje panowanie",
        "Z armią Twą przegnamy moce złe"
      ]
    }
  ]
}
