{
  "title": "Chwalimy Pana dziś za łaskę którą daje nam",
  "verses": [
    {
      "lines": [
        "Chwalimy Pana dziś",
        "Za łaskę, którą daje nam",
        "Chwalimy Pana dziś za Jego moc"
      ]
    },
    {
      "lines": [
        "Dziś z otwartym sercem",
        "Przychodzę doń",
        "Chcę wielbić Go szczerze",
        "Ze wszystkich sił"
      ]
    }
  ]
}
