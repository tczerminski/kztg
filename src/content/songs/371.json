{
  "title": "Ojcze, chwała Tobie",
  "verses": [
    {
      "lines": [
        "Ojcze chwała Tobie",
        "Swe życie składam Tobie",
        "Kocham Ciebie"
      ]
    },
    {
      "lines": [
        "Jezu chwała Tobie",
        "Swe życie składam Tobie",
        "Kocham Ciebie"
      ]
    },
    {
      "lines": [
        "Duchu chwała Tobie",
        "Swe życie składam Tobie",
        "Kocham Ciebie"
      ]
    }
  ]
}
