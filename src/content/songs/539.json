{
  "title": "To nasz Bóg, to nasz Pan",
  "verses": [
    {
      "lines": [
        "To nasz Bóg to nasz Pan",
        "Chwałę oddajmy mu",
        "Wznieśmy ręce i serca",
        "Wywyższajmy go"
      ]
    },
    {
      "lines": [
        "(: Bo Jezus odkupił nas :)",
        "Dał życie swe",
        "(: Do końca ukochał nas :)",
        "Wielbijmy go"
      ]
    }
  ]
}
