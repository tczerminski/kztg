{
  "title": "Hosanna, królowi królów cześć",
  "verses": [
    {
      "lines": [
        "(: Hosanna :)",
        "Królowi królów cześć"
      ]
    },
    {
      "lines": [
        "Chwalmy Pana,",
        "Śpiew niech brzmi",
        "Zmartwychwstał król",
        "I żyje dziś"
      ]
    },
    {
      "lines": [
        "O chwalmy go, najwyższy On",
        "I godzien wszelkiej czci"
      ]
    },
    {
      "lines": [
        "(: Kochamy :)",
        "Kochamy Panie Cię"
      ]
    },
    {
      "lines": [
        "(: Wielbimy :)",
        "Wielbimy Panie Cię"
      ]
    },
    {
      "lines": [
        "(: Chwalimy :)",
        "Chwalimy Panie Cię"
      ]
    }
  ]
}
