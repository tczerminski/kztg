{
  "title": "Dzisiaj jest mój szczęśliwy dzień",
  "verses": [
    {
      "lines": [
        "Dzisiaj jest mój szczęśliwy dzień",
        "Jezus znalazł mnie",
        "Jezus zbawił mnie",
        "Dziś idę tam,",
        "Gdzie już wieczne szczęście trwa",
        "Drogę znam, drogą jest mój Pan"
      ]
    },
    {
      "lines": [
        "Alleluja, alleluja,",
        "Dziś idę tam",
        "Gdzie już wieczne szczęście trwa",
        "Drogę znam, drogą jest mój Pan"
      ]
    }
  ]
}
