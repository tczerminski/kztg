{
  "title": "Chrystus wystarczy mi",
  "verses": [
    {
      "lines": [
        "Chrystus to mój Pan",
        "I tylko Jego wielbię",
        "Choćby wszystko dał mi świat",
        "Tylko w Bogu szczęście mam"
      ]
    },
    {
      "lines": [
        "Przez wszystkie dni",
        "Chcę śpiewać Ci",
        "Nie cofnę się",
        "Zbawiłeś mnie"
      ]
    },
    {
      "lines": [
        "Chrystus wystarczy mi",
        "Chrystus wystarczy mi",
        "Wszystko czego chcę, mam w Tobie",
        "Wszystko czego chcę"
      ]
    },
    {
      "lines": [
        "Chrystus wszystkim jest",
        "Zbawieniem i radością",
        "A nadzieja spełni się",
        "Bo Niebo to mój dom"
      ]
    },
    {
      "lines": [
        "Przez wszystkie dni",
        "Chce śpiewać Ci",
        "Ty jesteś tym",
        "Którego uwielbiam"
      ]
    },
    {
      "lines": [
        "Postanowiłem",
        "Iść za Jezusem",
        "Nie wrócę już",
        "Nie wrócę już"
      ]
    },
    {
      "lines": [
        "Ten świat jest za mną",
        "A krzyż przede mną",
        "Nie wrócę już",
        "Nie wrócę już"
      ]
    }
  ]
}
