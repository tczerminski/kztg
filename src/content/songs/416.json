{
  "title": "Panie tyś cenniejszy jest",
  "verses": [
    {
      "lines": [
        "Panie tyś",
        "Cenniejszy jest od srebra",
        "Panie tyś",
        "Od złota droższy mi",
        "Panie tyś",
        "Piękniejszy od diamentów",
        "I nikt na świecie",
        "Nie dorówna Ci"
      ]
    }
  ]
}
