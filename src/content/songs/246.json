{
  "title": "Kimże jestem, że Ty myślisz",
  "verses": [
    {
      "lines": [
        "Kimże jestem,",
        "Że Ty myślisz o mnie",
        "Że mnie słyszysz, gdy wołam Cię?",
        "Czy to prawda,",
        "Że wciąż myślisz o mnie",
        "Że mnie kochasz?",
        "To niezwykłe"
      ]
    },
    {
      "lines": [
        "(: Bóg przyjacielem mym :) x3",
        "On przy mnie jest"
      ]
    },
    {
      "lines": [
        "Boże wielki,",
        "Boże chwały,",
        "Jesteś blisko mnie"
      ]
    }
  ]
}
