{
  "title": "Wznieś głowę wzwyż",
  "verses": [
    {
      "lines": [
        "Wznieś głowę wzwyż",
        "Spójrz, na tronie król",
        "Skłoń się przed Nim",
        "W uwielbieniu",
        "I zaśpiewaj chwały pieśń"
      ]
    },
    {
      "lines": [
        "W majestacie swym",
        "Godzien wszelkiej czci",
        "Czysty, święty",
        "Pan wszechświata",
        "Królem królów jest!"
      ]
    }
  ]
}
