{
  "title": "Pan skałą i twierdzą",
  "verses": [
    {
      "lines": [
        "Pan skałą i twierdzą",
        "Wybawieniem moim",
        "Bóg moją opoką",
        "Na której polegać chcę",
        "Tarczą, rogiem zbawienia mego",
        "Warownią moją jest",
        "Wołam: niech będzie",
        "Pochwalony Pan!"
      ]
    }
  ]
}
