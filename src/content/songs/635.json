{
  "title": "Wnet nadejdzie dzień",
  "verses": [
    {
      "lines": [
        "(: Wnet nadejdzie dzień",
        "Gdy ujrzymy króla chwał :)",
        "Alleluja, alleluja,",
        "Gdy ujrzymy króla chwał."
      ]
    },
    {
      "lines": [
        "(: Wnet ustanie płacz",
        "Gdy ujrzymy króla chwał :)",
        "Alleluja, alleluja,",
        "Gdy ujrzymy króla chwał."
      ]
    },
    {
      "lines": [
        "(: Wnet ustanie śmierć",
        "Gdy ujrzymy króla chwał :)",
        "Alleluja, alleluja,",
        "Gdy ujrzymy króla chwał."
      ]
    },
    {
      "lines": [
        "Wnet przyjdzie dzień",
        "Gdy ujrzymy króla chwał",
        "Z aniołami przyjdzie On",
        "By zabrać kościół swój"
      ]
    },
    {
      "lines": [
        "Tak jak obiecał",
        "Przyjdzie zabrać wierny lud",
        "Odgłos trąb",
        "Towarzyszyć będzie mu"
      ]
    }
  ]
}
