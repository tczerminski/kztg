{
  "title": "W obecności Boga stańmy dziś",
  "verses": [
    {
      "lines": [
        "W obecności Boga stańmy dziś",
        "Wierząc i ufając,",
        "Że On przyjmie nas",
        "On już przygotował",
        "Wejście przed swój tron",
        "Dzięki krwi Jezusa wejdźmy tam"
      ]
    }
  ]
}
