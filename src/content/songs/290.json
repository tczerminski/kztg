{
  "title": "Mów, Panie mój",
  "verses": [
    {
      "lines": [
        "Mów Panie mój",
        "Bo sługa Twój słucha",
        "Mów słowo swe",
        "Wypełniać je chcę"
      ]
    },
    {
      "lines": [
        "Uszy me otwieram dziś",
        "Serce me do Ciebie lgnie",
        "Nogi me idą tam",
        "Gdzie Ty chcesz",
        "Język mój wypowiada słowa Twe"
      ]
    }
  ]
}
