{
  "title": "Krew Jezusa obmywa mnie",
  "verses": [
    {
      "lines": [
        "Krew Jezusa obmywa mnie",
        "Gdy wyznaję mu grzechy swe",
        "Krew obmywa mnie",
        "Krew obmywa mnie"
      ]
    },
    {
      "lines": [
        "Panie chcę do Ciebie przyjść",
        "Chcę na nowo z Tobą być",
        "Chcę z Tobą być",
        "Przez Twoją krew"
      ]
    },
    {
      "lines": [
        "Mogę dziś przed Tobą stać",
        "I nie muszę się bać",
        "Nie muszę się bać",
        "Przez Twoją krew"
      ]
    }
  ]
}
