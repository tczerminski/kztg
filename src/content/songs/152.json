{
  "title": "I wrócą przez Pana krew",
  "verses": [
    {
      "lines": [
        "I wrócą przez",
        "Pana krew odkupieni",
        "Przybędą z okrzykiem wesela",
        "Zniknie zmartwienie łzy i ból",
        "A radość ozdobi im twarz"
      ]
    },
    {
      "lines": [
        "Będą się śmiać",
        "Z radości w głos",
        "Zmartwiony i smutny",
        "Nie będzie nikt"
      ]
    }
  ]
}
