{
  "title": "Jezu – jesteś tu",
  "verses": [
    {
      "lines": [
        "Jezu jesteś tu",
        "Świat odszedł w cień",
        "Nie mam już nic",
        "Moje życie to Ty"
      ]
    },
    {
      "lines": [
        "Każdy dzień Twoim darem",
        "Nocą jesteś schronieniem mym",
        "Chwała, chwała",
        "Duch mój wielbi Cię",
        "Chwała, chwała",
        "Jezu chwalę Cię"
      ]
    }
  ]
}
