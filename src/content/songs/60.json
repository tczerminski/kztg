{
  "title": "Chodź, teraz jest czas by wielbić",
  "verses": [
    {
      "lines": [
        "Chodź, teraz jest czas by wielbić",
        "Chodź, teraz jest czas",
        "By serce dać",
        "Chodź, taki jak jesteś by wielbić",
        "Chodź, taki jak jesteś",
        "Przed Nim stań",
        "Chodź."
      ]
    },
    {
      "lines": [
        "Każdy język wyzna,",
        "Że Bogiem jest Pan",
        "Każdy Tobie pokłon da",
        "Dla tych, którzy",
        "Chętnie Cię przyjmą dziś",
        "Ty trzymasz wielki skarb"
      ]
    }
  ]
}
