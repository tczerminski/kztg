{
  "title": "Gdy kiedyś Pan powróci tu",
  "verses": [
    {
      "lines": [
        "Gdy kiedyś Pan powróci tu",
        "Gdy kiedyś Pan powróci tu",
        "Abyśmy też tam byli",
        "Gdy kiedyś Pan powróci tu"
      ]
    },
    {
      "lines": [
        "Gdy święci swój opuszczą grób",
        "Gdy święci swój opuszczą grób",
        "Abyśmy też tam byli",
        "Gdy święci swój opuszczą grób"
      ]
    },
    {
      "lines": [
        "Gdy księgę swą otworzy Pan",
        "Gdy księgę swą otworzy Pan",
        "Abyśmy też tam byli",
        "Gdy księgę swą otworzy Pan"
      ]
    },
    {
      "lines": [
        "Gdy po umieniu wezwie Pan",
        "Gdy po umieniu wezwie Pan",
        "Abyśmy też tam byli",
        "Gdy po umieniu wezwie Pan"
      ]
    },
    {
      "lines": [
        "Gdy zabrzmi pieśń alleluja",
        "Gdy zabrzmi pieśń alleluja",
        "Abyśmy też tam byli",
        "Gdy zabrzmi pieśń alleluja"
      ]
    }
  ]
}
