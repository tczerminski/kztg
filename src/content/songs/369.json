{
  "title": "Ojciec abraham",
  "verses": [
    {
      "lines": [
        "Ojciec abraham miał synów moc",
        "Wielką ilość synów ojciec miał",
        "A wśród synów tych ja i Ty",
        "Śpiewajmy razem tak"
      ]
    },
    {
      "lines": [
        "Prawa ręka, lewa ręka",
        "Prawa noga, lewa noga",
        "Głowa, ciało"
      ]
    }
  ]
}
