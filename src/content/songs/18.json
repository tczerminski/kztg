{
  "title": "Błogosławieństwo Jabeza",
  "verses": [
    {
      "lines": [
        "Pobłogosław mi, pobłogosław mi",
        "O, Panie, pobłogosław mi prawdziwie",
        "Poszerzaj moje granice",
        "O, Panie pobłogosław mi prawdziwie"
      ]
    },
    {
      "lines": [
        "Modlę się o Duchowy wzrost",
        "Modlę się o Duchowy wzrost"
      ]
    },
    {
      "lines": [
        "Chciałbym wzrastać, chciałbym wzrastać",
        "O, Panie, pobłogosław mi prawdziwie",
        "Poszerzaj moje granice",
        "O, Panie pobłogosław mi prawdziwie",
        "Modlę się o Duchowy wzrost"
      ]
    },
    {
      "lines": [
        "Trzymaj swoją rękę nade mną",
        "Tak, by zło mnie nie dosięgło",
        "Czy słońce, czy deszcz, choroba, czy ból",
        "Boże, z pokorą przychodzę do Ciebie",
        "Rozszerzaj moje granice",
        "Rozszerzaj moje granice"
      ]
    },
    {
      "lines": [
        "O, Panie, pobłogosław mi prawdziwie,",
