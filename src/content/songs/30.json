{
  "title": "Boże mój chcę wysławiać Ciebie dziś",
  "verses": [
    {
      "lines": [
        "(: Boże mój",
        "Chcę wysławiać Ciebie dziś :)",
        "Dusza moja pragnie Cię",
        "Tyś rozkoszą w każdym dniu",
        "Boże mój",
        "Chcę wysławiać Ciebie dziś"
      ]
    },
    {
      "lines": [
        "(: Panie Jezu",
        "Uwielbiam imię Twe :)",
        "Słowo Twe światłością jest",
        "Gdy przychodzi w mocy Twej",
        "Panie Jezu uwielbiam imię Twe"
      ]
    },
    {
      "lines": [
        "(: Duchu Święty",
        "Wypełnij dzisiaj mnie :)",
        "Abym dzięki sile Twej",
        "Mógł zwyciężać wszelkie zło",
        "Duchu Święty",
        "Wypełnij dzisiaj mnie"
      ]
    }
  ]
}
