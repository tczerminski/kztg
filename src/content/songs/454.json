{
  "title": "Przyjdźmy tam, gdzie miejsce",
  "verses": [
    {
      "lines": [
        "Przyjdźmy tam",
        "Gdzie miejsce najświętsze",
        "Przez baranka krew",
        "Wejdźmy tam",
        "Przyjdźmy doń",
        "Śpiewaniem Go wielbiąc",
        "Wywyższając Boży tron"
      ]
    },
    {
      "lines": [
        "Wznosząc ręce swe",
        "Wielbiąc króla chwał",
        "Chwała Ci Jezu! Chwała Ci Jezu!"
      ]
    }
  ]
}
