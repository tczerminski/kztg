{
  "title": "Godzien jesteś",
  "verses": [
    {
      "lines": [
        "Godzien jesteś wielki Boże",
        "By pokorną przyjąć cześć z moich ust",
        "Kocham Ciebie, wielbię Panie i z radością",
        "Składam życie u Twych stóp"
      ]
    },
    {
      "lines": [
        "(: Panie zanurz nas",
        "W miłości swojej",
        "Panie zanurz nas",
        "W miłości swej :)"
      ]
    }
  ]
}
