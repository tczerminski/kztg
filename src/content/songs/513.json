{
  "title": "Święte imię Jezus",
  "verses": [
    {
      "lines": [
        "Święte imię Jezus",
        "Święte imię Jezus",
        "Jest na ustach mych",
        "I w sercu mym",
        "W mocy Ducha uwielbiam Cię"
      ]
    },
    {
      "lines": [
        "Nie ma w innym zbawienia",
        "Gdyż nie dano nam ludziom",
        "Innego imienia",
        "W Nim zbawienie jest"
      ]
    }
  ]
}
