{
  "title": "Wspaniałe jest zwycięstwo w imieniu Jezusa",
  "verses": [
    {
      "lines": [
        "Wspaniałe jest zwycięstwo",
        "W imieniu Jezusa",
        "On podniósł mnie, On wykupił mnie",
        "Najświętszą swoją krwią",
        "Odszukał mnie i zbawił",
        "Choć byłem tak daleko",
        "Swym słowem oczyszcza mnie",
        "Prowadzi drogą swą"
      ]
    }
  ]
}
