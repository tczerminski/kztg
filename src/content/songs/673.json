{
  "title": "Zmartwychwstał Pan, przeminęła trwoga",
  "verses": [
    {
      "lines": [
        "Zmartwychwstał Pan",
        "Przeminęła trwoga",
        "Zmartwychwstał Pan",
        "Zwyciężył śmierć",
        "Zmartwychwstał Pan",
        "Otworzył drogę",
        "Więc życie me ma teraz sens",
        "Bo żyje Pan!"
      ]
    },
    {
      "lines": [
        "Wiem, żyje Pan",
        "W Nim mam pewność jutra",
        "Wiem, żyje Pan",
        "Znikł wszelki strach",
        "I wiem, że On",
        "Zna moją przyszłość",
        "Więc warto żyć",
        "Bo pewność mam, że żyje Pan"
      ]
    }
  ]
}
