{
  "title": "Wielki jesteś Panie",
  "verses": [
    {
      "lines": [
        "Wielki jesteś Panie",
        "Godzien wszelkiej chwały",
        "Tobie dziś oddaję",
        "Cały świat mój mały",
        "Wielka Twoja miłość",
        "Uzdrowiła moje serce",
        "Oprócz Twojej łaski",
        "Nie potrzeba mi nic więcej"
      ]
    }
  ]
}
