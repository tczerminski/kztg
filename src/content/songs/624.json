{
  "title": "Wielkie wody",
  "verses": [
    {
      "lines": [
        "(: Wielkie wody nie ugaszą jej",
        "Nie zaleją jej strumienie",
        "Obawy i strach nie zrobią nic",
        "Miłości Twej :)",
        "Miłości Twej"
      ]
    },
    {
      "lines": [
        "Miłość Twa wciąż napełnia mnie",
        "Niech wypełni mnie",
        "Jak najgłębsze z mórz",
        "Jak największa z fal",
        "Niech przykryje mnie",
        "Niech zaleje mnie miłość Twa"
      ]
    },
    {
      "lines": [
        "(: Wielkie troski",
        "Nie przysłonią jej",
        "Ciemność już jej nie ukryje",
        "Nie muszę się bać bo miłość Twa",
        "Ochrania mnie :)",
        "Sam ochraniasz mnie"
      ]
    },
    {
      "lines": [
        "Gdy mam Ciebie – mam zbawienie",
        "Gdy mam Ciebie pokój mam",
        "I nie będzie już tak",
        "Szerokich rzek, tak wysokich gór",
        "Tak głębokich mórz, by rozdzielić nas"
      ]
    }
  ]
}
