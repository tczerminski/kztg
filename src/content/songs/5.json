{
  "title": "Alleluja, alleluja króluje",
  "verses": [
    {
      "lines": [
        "Alleluja, alleluja!",
        "Króluje wszechmocny nasz Bóg",
        "Alleluja, alleluja!"
      ]
    },
    {
      "lines": [
        "Święty! Święty!",
        "Jesteś Panem wszechmocnym!",
        "Baranek godzien jest!",
        "Baranek godzien jest!",
        "Amen!"
      ]
    }
  ]
}
