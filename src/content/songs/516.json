{
  "title": "Święty Pan, Jego imię święte jest",
  "verses": [
    {
      "lines": [
        "Święty Pan",
        "Jego imię święte jest"
      ]
    },
    {
      "lines": [
        "Oddaj mu chwałę",
        "Hołd świętemu imieniu",
        "W uwielbieniu pokłoń się",
        "Chwaląc święte imię to!"
      ]
    }
  ]
}
