{
  "title": "Za rękę weź mnie Panie",
  "verses": [
    {
      "lines": [
        "Za rękę weź mnie, Panie",
        "I trzymaj mnie mocno",
        "Aż przed Tobą stanę, do Twoich stóp skłonię się",
        "Nie zrobię ani kroku, bez Ciebie, nie",
        "Więc stań u mego boku i prowadź mnie, Boże mój."
      ]
    },
    {
      "lines": [
        "Jesteś życiem mym (jesteś życiem)",
        "Tęsknię za Duchem Twym (tęsknię, tęsknię)",
        "Nie potrafię bez Ciebie żyć",
        "Jesteś Bogiem mym (Bogiem mym)"
      ]
    }
  ]
}
