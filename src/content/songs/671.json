{
  "title": "Zgromadzamy się dla Ciebie",
  "verses": [
    {
      "lines": [
        "(: Zgromadzamy się",
        "Dla Ciebie Panie nasz :)",
        "By w imieniu Twym oddać",
        "Ojcu chwałę, cześć",
        "I społeczność z Tobą",
        "Panie Jezu mieć"
      ]
    },
    {
      "lines": [
        "(: Wy jesteście na ziemi",
        "Światłem mym :)",
        "Aby ludzie widzieli",
        "Dobre czyny w was",
        "I chwalili Ojca,",
        "Który w niebie jest"
      ]
    },
    {
      "lines": [
        "(: My jesteśmy na ziemi",
        "Światłem Twym :)",
        "Aby ludzie widzieli",
        "Dobre czyny w nas",
        "I chwalili Ojca,",
        "Który w niebie jest"
      ]
    }
  ]
}
