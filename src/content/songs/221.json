{
  "title": "Jezus jest tu",
  "verses": [
    {
      "lines": [
        "(: Jezus jest tu! :)",
        "O! Wznieśmy ręce",
        "Chwaląc Jego imię",
        "Jezus jest tu!"
      ]
    },
