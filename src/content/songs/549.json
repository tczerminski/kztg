{
  "title": "Twe miłosierdzie",
  "verses": [
    {
      "lines": [
        "Twe miłosierdzie",
        "Wciąż spływa i spływa",
        "Tak jak wiosenny ciepły deszcz",
        "Twe miłosierdzie",
        "Wciąż spływa i spływa na mnie"
      ]
    },
    {
      "lines": [
        "Hej ho! Przyjmę Twoją łaskę",
        "Hej ho! Miłosierdzie Twe",
        "Hej ho! Będę z Tobą",
        "Tańczyć dziś"
      ]
    },
    {
      "lines": [
        "La, la, la…"
      ]
    }
  ]
}
