{
  "title": "Nie mam nic",
  "verses": [
    {
      "lines": [
        "Nie mam nic",
        "Co by można Tobie dać",
        "Nie mam sił",
        "By przed Tobą Panie stać",
        "Puste ręce przynoszę",
        "Przed Twój w niebie tron",
        "Manną z nieba nakarm duszę mą"
      ]
    },
    {
      "lines": [
        "Pomaż maścią leczącą oczy me",
        "Spraw by język mój",
        "Też przemówić chciał",
        "Puste ręce przynoszę",
        "Przed Twój w niebie tron",
        "Manną z nieba nakarm duszę mą"
      ]
    }
  ]
}
