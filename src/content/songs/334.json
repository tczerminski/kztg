{
  "title": "Niech Twój Święty Duch",
  "verses": [
    {
      "lines": [
        "Niech Twój Święty Duch",
        "Dziś przenika mnie",
        "I niech zawsze już",
        "Gości w duszy mej"
      ]
    },
    {
      "lines": [
        "I niech spadnie deszcz",
        "Błogosławieństw Twych",
        "Ojcze obmyj mnie",
        "Duchu Święty przyjdź"
      ]
    },
    {
      "lines": [
        "Duchu Święty przyjdź",
        "Działaj mocą w nas",
        "Duchu Święty przyjdź",
        "Przemień smutku czas"
      ]
    },
    {
      "lines": [
        "I niech spadnie deszcz",
        "Błogosławieństw Twych",
        "Ojcze obmyj mnie",
        "Duchu Święty przyjdź"
      ]
    },
    {
      "lines": [
        "Daj radości czas",
        "Daj pokoju czas",
        "Daj wolności czas",
        "Daj miłości czas"
      ]
    }
  ]
}
