{
  "title": "Wejdę do Jego bram",
  "verses": [
    {
      "lines": [
        "Wejdę do Jego bram",
        "Z dziękczynieniem w sercu swym",
        "Pójdę przed Jego tron",
        "Z pieśnią chwał",
        "Powiem dziś, że to jest dzień",
        "Który sprawił Pan",
        "Wciąż cieszę się,",
        "Bo radość dał mi Pan!"
      ]
    },
    {
      "lines": [
        "(: Radość dał mi Pan :)",
        "Wciąż cieszę się,",
        "Bo radość dał mi Pan"
      ]
    }
  ]
}
