{
  "title": "On jest moim życiem",
  "verses": [
    {
      "lines": [
        "On jest moim życiem",
        "On jest moją siłą",
        "On jest mą nadzieją",
        "Jezus mój Pan!"
      ]
    },
    {
      "lines": [
        "Wielbić Cię chcę życiem mym",
        "Wielbić Cię chcę pieśnią mą",
        "Ze wszystkich mych sił",
        "Uwielbiać Cię chcę",
        "Moja nadzieja to Ty!"
      ]
    }
  ]
}
