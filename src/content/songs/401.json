{
  "title": "Pan strzeże, wybawia od ucisków mnie",
  "verses": [
    {
      "lines": [
        "Pan strzeże, wybawia",
        "Od ucisków mnie",
        "Pan jest schronieniem mym"
      ]
    },
    {
      "lines": [
        "Alleluja!",
        "Pan jest schronieniem mym!"
      ]
    }
  ]
}
