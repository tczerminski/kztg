{
  "title": "Jakże cudowna Twoja łaska",
  "verses": [
    {
      "lines": [
        "Jakże cudowna Twoja łaska",
        "Jakże cudowna Twoja moc",
        "Jakże cudowna Twoja łaska",
        "Przenika mnie co dzień"
      ]
    },
    {
      "lines": [
        "Dzięki Ci (dzięki Ci)"
      ]
    }
  ]
