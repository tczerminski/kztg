{
  "title": "Nie muszę mieć pretekstu",
  "verses": [
    {
      "lines": [
        "Nie muszę mieć pretekstu",
        "By śpiewać bluesa dla Jezusa",
        "(O nie!)"
      ]
    },
    {
      "lines": [
        "On godzien chwały jest",
        "Każdego dnia",
        "On godzien chwały jest!"
      ]
    },
    {
      "lines": [
        "Nie muszę mieć pretekstu",
        "By tańczyć bluesa dla Jezusa",
        "(O nie!)"
      ]
    },
    {
      "lines": [
        "Nie muszę mieć pretekstu",
        "By klaskać bluesa dla Jezusa",
        "(O nie!)"
      ]
    }
  ]
}
