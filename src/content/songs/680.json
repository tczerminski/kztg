{
  "title": "Zostałem powołany",
  "verses": [
    {
      "lines": [
        "Zostałem powołany",
        "Powołany do istnienia",
        "Powołany by uwielbiać",
        "Powołany by zwyciężać",
        "Idę i nie oglądam się"
      ]
    },
    {
      "lines": [
        "A koniec mojej drogi",
        "W złotym jeruzalem",
        "A koniec mojej drogi",
        "W mieście świętym"
      ]
    }
  ]
}
