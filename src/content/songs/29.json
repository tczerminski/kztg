{
  "title": "Boża obecność dziś wypełnia",
  "verses": [
    {
      "lines": [
        "Boża obecność",
        "Dziś wypełnia miejsce to",
        "Odczuwamy Jego łaskę",
        "Jego moc"
      ]
    },
    {
      "lines": [
        "Słychać szum",
        "Anielskich skrzydeł w krąg",
        "Twarze blaskiem chwały lśnią",
        "Boża obecność",
        "Dziś wypełnia miejsce to"
      ]
    }
  ]
}
