{
  "title": "Boże nasz Ty stworzyłeś niebo",
  "verses": [
    {
      "lines": [
        "Boże nasz",
        "Ty stworzyłeś niebo",
        "Cały wszechświat mocą swoją",
        "Panie nasz",
        "Ty stworzyłeś ziemię",
        "Wyciągniętym ramieniem swym"
      ]
    },
    {
      "lines": [
        "Wszystko mocą swoją",
        "Możesz sprawić Panie",
        "Wszystko jest",
        "Dla Ciebie możliwe",
        "Potężny Boże nasz",
        "Wielki w radzie",
        "I w czynach swych"
      ]
    },
    {
      "lines": [
        "Wszystko, wszystko",
        "Absolutnie wszystko",
        "Wszystko możesz sprawić mocą swą"
      ]
    }
  ]
}
