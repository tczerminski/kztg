{
  "title": "Swą miłość, której nikt nie wyrazi",
  "verses": [
    {
      "lines": [
        "Swą miłością, której nikt",
        "Nie wyrazi mocą słów",
        "Wypełniłeś serce me",
        "W dniu, gdy w świat wkroczyłeś mój",
        "Alleluja, On ukochał mnie",
        "Król, zbawiciel mój"
      ]
    },
    {
      "lines": [
        "(: Jezusa krew nie zawiedzie mnie :)",
        "Jezusa krew, Jezusa krew"
      ]
    },
    {
      "lines": [
        "Aż po krańce ziemi tej",
        "Głos tej prawdy będzie brzmieć",
        "Miłość Twa sprawiła, że",
        "Jestem wolny mocą krwi",
        "Alleluja, On ukochał mnie",
        "Król, zbawiciel mój"
      ]
    },
    {
      "lines": [
        "Śpiewaj pieśń wolności",
        "Uwielbiaj Boga nieba",
        "Jego miłość nie zawodzi",
        "Przez Jezusa krew, Jezusa krew"
      ]
    }
  ]
}
