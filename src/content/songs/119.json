{
  "title": "Dziś przychodzę, Panie mój",
  "verses": [
    {
      "lines": [
        "(: Dziś przychodzę, Panie mój,",
        "Tak jak wzywasz mnie,",
        "By wielbić Cię! :)",
        "Dziś przychodzę, Panie mój,",
        "Tak jak wzywasz mnie,",
        "By wielbić imię Twe!",
        "Chwalę Cię, wielbię imię Twe!"
      ]
    },
    {
      "lines": [
        "(: Rzuć w niepamięć przeszłość swą,",
        "Jezus jest wśród nas,",
        "Więc chwalmy Go :)",
        "Rzuć w niepamięć przeszłość swą,",
        "Jezus jest wśród nas,",
        "Więc uwielbiajmy Go",
        "Chwalmy Go, uwielbiajmy Go"
      ]
    },
    {
      "lines": [
        "(: Do Jezusa zbliżmy się,",
        "Wznieśmy ręce swe",
        "I chwalmy Go :)",
        "Do Jezusa zbliżmy się,",
        "Wznieśmy ręce swe",
        "I uwielbiajmy Go",
        "Chwalmy Go, uwielbiajmy Go"
      ]
    }
  ]
}
