{
  "title": "Niechaj miłość Twa",
  "verses": [
    {
      "lines": [
        "Niechaj miłość Twa",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    },
    {
      "lines": [
        "Niechaj pokój Twój",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    },
    {
      "lines": [
        "Niechaj łaska Twa",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    },
    {
      "lines": [
        "Niechaj radość Twa",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    },
    {
      "lines": [
        "Niechaj dobroć Twa",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    },
    {
      "lines": [
        "Niechaj chwała Twa",
        "Jak potężna fala spłynie tu",
        "Przez łaski Twej zdrój",
        "Jezu dotknij mnie"
      ]
    }
  ]
}
