{
  "title": "O jak dobrze",
  "verses": [
    {
      "lines": [
        "O jak dobrze, jak dobrze, jak miło",
        "Kiedy bracia w zgodzie żyją",
        "Wtedy Pan udziela błogosławieństw",
        "Daje życie wieczne"
      ]
    },
    {
      "lines": [
        "(: Ojcze połącz nas :)",
        "Aby poznał świat",
        "Żeś nam syna dał",
        "Ojcze połącz nas"
      ]
    },
    {
      "lines": [
        "O jak dobrze, jak dobrze, jak miło",
        "Kiedy siostry w zgodzie żyją",
        "Wtedy Pan udziela błogosławieństw",
        "Daje życie wieczne"
      ]
    },
    {
      "lines": [
        "O jak dobrze, jak dobrze, jak miło",
        "Gdy wszyscy w zgodzie żyją",
        "Wtedy Pan udziela błogosławieństw",
        "Daje życie wieczne"
      ]
    }
  ]
}
