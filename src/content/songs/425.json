{
  "title": "Pokój jak rzeka",
  "verses": [
    {
      "lines": [
        "Pokój jak rzeka",
        "Miłość jak górski wiatr",
        "Gdy moc Twego Ducha",
        "Ogarnia cały świat",
        "Radość jak strumień",
        "Koi duszę mą"
      ]
    },
    {
      "lines": [
        "Przyjdź Duchu Święty",
        "Ogniem swoim zstąp"
      ]
    }
  ]
}
