{
  "title": "Wywyższam królu Cię",
  "verses": [
    {
      "lines": [
        "Wywyższam królu Cię",
        "Twe imię",
        "Pokłoni każdy się",
        "Przed tronem Twym",
        "Wywyższam królu Cię",
        "Twe imię",
        "Któż jest jak Ty,",
        "Któż taki jest jak Ty"
      ]
    },
    {
      "lines": [
        "Wieczny król",
        "Wielki majestat Twój",
        "Niebo, morze, ziemia",
        "Stworzone mocą Twą",
        "Wieczny król",
        "Wielki majestat Twój",
        "Zbawienia mego skała",
        "Schronienie duszy mej"
      ]
    }
  ]
}
