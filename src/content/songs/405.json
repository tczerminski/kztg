{
  "title": "Panię chcę wielbić Cię",
  "verses": [
    {
      "lines": [
        "Panie chcę wielbić Cię",
        "Sławić wśród narodów",
        "Będę śpiewem chwalić Cię",
        "Przed ludźmi",
        "Miłości Twej moc",
        "Wyższa niż niebiosa",
        "A wierność Twa sięga aż do gwiazd"
      ]
    },
    {
      "lines": [
        "Wywyższony bądź Boże",
        "Nad niebiosa",
        "Niech chwała Twa napełnia",
        "Cały świat"
      ]
    }
  ]
}
