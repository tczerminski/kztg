{
  "title": "Jezus żyje, jestem wolny",
  "verses": [
    {
      "lines": [
        "Jezus żyje, jestem wolny",
        "Kamień odrzucony jest",
        "Jezus żyje, jestem wolny",
        "On nie leży w grobie – nie"
      ]
    },
    {
      "lines": [
        "Jezus żyje, jestem wolny",
        "Słychać już aniołów głos",
        "Niech wszyscy ludzie dziś radują się"
      ]
    }
  ]
}
