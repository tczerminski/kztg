{
  "title": "Jezus jest mym Panem",
  "verses": [
    {
      "lines": [
        "Jezus jest mym Panem",
        "(: Mym mistrzem i zbawcą :) x3",
        "Takim na wieki on! Halleluja"
      ]
    },
    {
      "lines": [
        "Panie Jezu chwała Ci",
        "Chwała za Twoją świętą krew",
        "Królów król i panów Pan!",
        "Bóg abrahama! Halleluja",
        "Bóg abrahama!"
      ]
    },
    {
      "lines": [
        "Jezus mnie uwalnia",
        "(: Z mych grzechów codziennie :) x3",
        "On daje wolność mi! Halleluja"
      ]
    }
  ]
}
