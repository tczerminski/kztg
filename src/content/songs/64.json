{
  "title": "Chwal Pana, chwal, duszo moja",
  "verses": [
    {
      "lines": [
        "Chwal Pana,",
        "(: Chwal duszo moja :) x3",
        "Moja duszo uwielbiaj Go wciąż!"
      ]
    },
    {
      "lines": [
        "I miej w pamięci, i miej w pamięci",
        "Każdy znak łaski od Pana!"
      ]
    },
    {
      "lines": [
        "Bo On przebacza",
        "Wszystkie twe winy",
        "I leczy twoje choroby"
      ]
    },
    {
      "lines": [
        "On cię wybawia od potępienia",
        "I wieńczy cię miłosierdziem"
      ]
    },
    {
      "lines": [
        "Życie twe syci obficie dobrem",
        "A młodość twoją odnawia"
      ]
    }
  ]
}
