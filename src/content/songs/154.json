{
  "title": "Idzie mój Pan",
  "verses": [
    {
      "lines": [
        "(: Idzie mój Pan :)",
        "Już blisko jest we drzwiach"
      ]
    },
    {
      "lines": [
        "To Jezus idzie, już słyszę",
        "Jego głos – jak dzwon",
        "To Jezus, to idzie mój Pan"
      ]
    }
  ]
}
