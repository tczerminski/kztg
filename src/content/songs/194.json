{
  "title": "Jesteśmy w Nim",
  "verses": [
    {
      "lines": [
        "Jesteśmy w nim,",
        "I w Nim jest nasze życie"
      ]
    },
    {
      "lines": [
        "Głośno raduj się",
        "Śpiewaj Panu chwał",
        "Miłość wyznaj mu",
        "Skacząc przed Nim"
      ]
    },
    {
      "lines": [
        "Głośno raduj się",
        "Śpiewaj Panu chwał",
        "Miłość wyznaj mu",
        "Halleluja"
      ]
    }
  ]
}
