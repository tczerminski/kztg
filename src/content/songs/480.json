{
  "title": "Słowo Twe od strachu chroni mnie",
  "verses": [
    {
      "lines": [
        "Słowo Twe od strachu chroni mnie",
        "Czytam je",
        "Śmierć nie pochłonie mnie",
        "Słowo Twe to powodzenie me",
        "Wierze w nie",
        "Uzdrawia dzisiaj mnie",
        "Słowo Twe zwycięża to co złe",
        "Słowo Twe uwalnia mnie"
      ]
    },
    {
      "lines": [
        "Imię Twe od strachu chroni mnie",
        "Wzywam je",
        "Śmierć nie pochłonie mnie",
        "Imię Twe to powodzenie me",
        "Wierzę w nie",
        "Uzdrawia dzisiaj mnie",
        "Imię Twe zwycięża to co złe",
        "Imię Twe uwalnia mnie"
      ]
    },
    {
      "lines": [
        "Twoja krew od strachu",
        "Chroni mnie zmywa grzech",
        "Śmierć nie pochłonie mnie",
        "Twoja krew to powodzenie me",
        "Wierzę w nią",
        "Uzdrawia dzisiaj mnie",
        "Twoja krew zwycięża to co złe",
        "Twoja krew uwalnia mnie"
      ]
    }
  ]
}
