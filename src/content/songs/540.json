{
  "title": "To przykazanie",
  "verses": [
    {
      "lines": [
        "To przykazanie ja dziś daję wam",
        "Byście się miłowali",
        "Jak ja miłuję was"
      ]
    },
    {
      "lines": [
        "A wtedy wszyscy poznają",
        "Żeście moi",
        "Gdy miłość wzajemną",
        "Mieć będziecie"
      ]
    }
  ]
}
