{
  "title": "Lepszy jeden dzień",
  "verses": [
    {
      "lines": [
        "Lepszy jeden dzień",
        "W przedsionkach Twych",
        "Lepszy jeden dzień",
        "W domu Twym",
        "Niż gdzie indziej",
        "Panie mój tysiąc dni"
      ]
    },
    {
      "lines": [
        "Lepiej w domu Twoim być",
        "Niż gdzie indziej spędzać czas",
        "W Tobie radość,",
        "Pokój i zbawienie jest"
      ]
    },
    {
      "lines": [
        "Jesteś mą nadzieją",
        "Jesteś mym schronieniem",
        "Moją twierdzą – nie boję się",
        "Wywyższam, chwalę Cię",
        "Ja kocham Cię"
      ]
    }
  ]
}
