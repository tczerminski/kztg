{
  "title": "Imię Jezus",
  "verses": [
    {
      "lines": [
        "Nie ma imienia nad imię Jezus",
        "Tylko to imię tak piękne jest",
        "Nie ma imienia nad imię Jezus"
      ]
    },
    {
      "lines": [
        "Jezus jest światłem",
        "Co rozjaśnia mrok",
        "Jezus jest życiem",
        "Dla duszy i serca",
        "On jest nadzieją",
        "Miłością i mocą",
        "Jedyną drogą i prawdą jest On"
      ]
    }
  ]
}
