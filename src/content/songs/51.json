{
  "title": "Chcę Panie sławić Cię wciąż",
  "verses": [
    {
      "lines": [
        "Chcę Panie sławić Cię wciąż",
        "Bo Ty dźwignąłeś mnie wzwyż",
        "Zamieniłeś w radość moje łzy"
      ]
    },
    {
      "lines": [
        "Z wdzięcznością wołam",
        "I nie mogę milczeć",
        "Już na wieki sławić będę",
        "Imię Twe"
      ]
    }
  ]
}
