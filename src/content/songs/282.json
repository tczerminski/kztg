{
  "title": "Mój Bóg jest wielki",
  "verses": [
    {
      "lines": [
        "Mój Bóg jest wielki,",
        "On przenosi góry,",
        "Wspiera mnie w dolinie,",
        "Zawsze przy mnie jest."
      ]
    },
    {
      "lines": [
        "Mój Bóg jest wielki,",
        "Leczy moje rany,",
        "Wzmacnia moje siły",
        "Nie opuści mnie."
      ]
    },
    {
      "lines": [
        "Mój Bóg jest wielki",
        "Wielki, wielki, wielki"
      ]
    },
    {
      "lines": [
        "Mój Bóg jest wielki,",
        "Zbawca wszystkich ludzi,",
        "Pełnia uzdrowienia",
        "Płynie z Jego ran."
      ]
    },
    {
      "lines": [
        "On jest cudowny,",
        "Wszystko mi wybaczył,",
        "Dzięki Jego łasce",
        "Nowe życie mam."
      ]
    },
    {
      "lines": [
        "(: Potężny :) x4",
        "Wielki, wielki",
        "(: Wspaniały :) x4",
        "Wielki, wielki",
        "(: Święty :) x4",
        "Wielki, wielki",
        "(: Wszechmogący :) x4",
        "Wielki, wielki"
      ]
    }
  ]
}
