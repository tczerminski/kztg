{
  "title": "Obecność Twa, niebem jest mym",
  "verses": [
    {
      "lines": [
        "Któż jest jak nasz Pan na ziemi tej",
        "Nieskończona miłość, piękno Twe",
        "Nic w tym świecie nie da szczęścia mi",
        "Źródłem moim jesteś tylko Ty"
      ]
    },
    {
      "lines": [
        "Obecność Twa niebem jest mym",
        "Obecność Twa niebem jest mym"
      ]
    },
    {
      "lines": [
        "Tyś skarbem mego serca, duszy mej",
        "Miłosierdziem swoim darzysz mnie",
        "Ty przebaczasz wszystkie winy me",
        "Przyszłość ma bezpieczna w Tobie jest"
      ]
    },
    {
      "lines": [
        "Dziś cierpliwie czekam Panie aż",
        "Znów zobaczę Ciebie twarzą w twarz",
        "Nic w tym świecie nie da szczęścia mi",
        "Źródłem moim jesteś tylko Ty"
      ]
    },
    {
      "lines": [
        "O Jezu, o Jezu",
        "(: Obecność Twa niebem jest mym :)"
      ]
    }
  ]
}
