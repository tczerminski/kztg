{
  "title": "Dzisiaj dla Jezusa",
  "verses": [
    {
      "lines": [
        "Dzisiaj dla Jezusa",
        "Wszystko to co mam,",
        "Kim jestem i kim chciałbym być",
        "Dzisiaj dla Jezusa",
        "Wszystko to co mam,",
        "Kim jestem i chcę być"
      ]
    },
    {
      "lines": [
        "Wszystkie me ambicje, plany też",
        "Powierzam Ci",
        "Oddaję w ręce Twe",
        "Wszystkie me nadzieje, plany też",
        "Powierzam Ci",
        "Oddaję w ręce Twe"
      ]
    },
    {
      "lines": [
        "Tylko z woli Twej jestem wolny"
      ]
    }
  ]
}
