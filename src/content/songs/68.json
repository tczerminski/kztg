{
  "title": "Chwalę Cię Panie całym swym sercem",
  "verses": [
    {
      "lines": [
        "Chwalę Cię Panie",
        "Całym swym sercem",
        "Opowiadam wszystkie",
        "Cudowne Twe dzieła",
        "Cieszyć się będę i radować Tobą",
        "Psalm śpiewać będę",
        "Na cześć Twego imienia"
      ]
    },
    {
      "lines": [
        "(: O Najwyższy :)"
      ]
    }
  ]
}
