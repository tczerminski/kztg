{
  "title": "Łaska Twa sięga aż do niebios",
  "verses": [
    {
      "lines": [
        "Łaska Twa sięga aż do niebios",
        "Wierność Twa pod obłoków cień",
        "Twa sprawiedliwość",
        "Jest jak góry, Boże",
        "Prawo Twe – niezgłębiona toń"
      ]
    },
    {
      "lines": [
        "Wznoszę dłonie swe,",
        "By chwałę oddać Ci",
        "W cieniu skrzydeł Twych",
        "Dajesz pokój, siłę mi"
      ]
    }
  ]
}
