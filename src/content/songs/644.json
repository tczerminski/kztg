{
  "title": "Wszyscy spragnieni w słabości swej",
  "verses": [
    {
      "lines": [
        "Wszyscy spragnieni w słabości swej",
        "Przyjdźcie do źródła by zanurzyć swe serce w Nim",
        "Odrzuć bóle i smutki, daj obmyć się",
        "W morzu Jego miłości",
        "Pragnę głębiej zanurzyć się"
      ]
    },
    {
      "lines": [
        "Wołam Panie Jezu przyjdź",
        "Wołam Panie Jezu przyjdź",
        "Wołam Duchu Święty przyjdź",
        "Wołam Duchu Święty przyjdź"
      ]
    }
  ]
}
