{
  "title": "Ześlij deszcz i wylej swego Ducha",
  "verses": [
    {
      "lines": [
        "(: Ześlij deszcz :)",
        "I wylej swego Ducha",
        "Na nasz kraj",
        "(: Ześlij deszcz :)",
        "Napełnij nas swą mocą,",
        "Światłem swym",
        "Ześlij deszcz"
      ]
    },
    {
      "lines": [
        "Niech przepływa",
        "Strumień Ducha",
        "Przez wszelkie ziemskie ciało",
        "I potoki wody żywej",
        "Niech wypłyną z nas"
      ]
    },
    {
      "lines": [
        "I napełnij swoim Duchem",
        "Twój święty naród",
        "Aż każdy człowiek",
        "Padnie na kolana",
        "Przed Panem swym"
      ]
    }
  ]
}
