{
  "title": "Uwielbiam Cię, wywyższam",
  "verses": [
    {
      "lines": [
        "Uwielbiam Cię, wywyższam Ciebie,",
        "Do Ciebie podnoszę me ręce",
        "Tyś Panem mym jest",
        "Tyś królem mym"
      ]
    },
    {
      "lines": [
        "Uwielbiam Cię, wywyższam Ciebie,",
        "Do Ciebie podnoszę me serce",
        "Tyś Panem mym jest",
        "Tyś królem mym"
      ]
    },
    {
      "lines": [
        "Ooo, tak tyś Panem mym jest",
        "Tyś królem mym"
      ]
    }
  ]
}
