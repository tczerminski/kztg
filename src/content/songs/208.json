{
  "title": "Jezu tyś Panem moim jest",
  "verses": [
    {
      "lines": [
        "Jezu tyś Panem moim jest",
        "Wyznaję Cię",
        "I ogłaszam królem mym"
      ]
    },
    {
      "lines": [
        "Niech żyje król! (Niech żyje król)",
        "Niech żyje król! (Niech żyje król)",
        "Niech żyje król!",
        "Mój Pan i mój Bóg"
      ]
    }
  ]
}
