{
  "title": "Halleluja, Panem jest",
  "verses": [
    {
      "lines": [
        "Halleluja! (Halleluja)",
        "Panem jest! (Panem jest)",
        "Halleluja! Jezus to Pan!"
      ]
    },
    {
      "lines": [
        "Halleluja! (Halleluja)",
        "Królem jest! (Królem jest)",
        "Halleluja! Jezus to król!"
      ]
    },
    {
      "lines": [
        "Halleluja! Jezus królem jest!"
      ]
    }
  ]
}
