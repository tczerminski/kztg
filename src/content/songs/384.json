{
  "title": "Oto On żyje",
  "verses": [
    {
      "lines": [
        "Oświeć mnie, oświeć mnie",
        "Niech Jezusa blask",
        "Oświeci mnie"
      ]
    },
    {
      "lines": [
        "Oczyść mnie, oczyść mnie",
        "Niech Jezusa krew",
        "Oczyści mnie"
      ]
    },
    {
      "lines": [
        "Prowadź mnie, prowadź mnie",
        "Niech Jezusa Duch",
        "Prowadzi mnie"
      ]
    }
  ]
}
