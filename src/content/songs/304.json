{
  "title": "Nasz Pan to święty Bóg",
  "verses": [
    {
      "lines": [
        "Nasz Pan to święty Bóg",
        "On w chwałach ludu przebywa",
        "(: Święty Bóg –",
        "W chwałach ludu przebywa :)",
        "W chwałach swego ludu"
      ]
    },
    {
      "lines": [
        "Dziś uwielbiamy Twoje imię",
        "W społeczności dzieci Bożych",
        "Wywyższając imię Twe –",
        "Korzymy się",
        "Cześć oddajemy chwaląc Pana",
        "W zgromadzeniu Jego ludu",
        "Bo On jest godzien wszelkiej czci"
      ]
    }
  ]
}
