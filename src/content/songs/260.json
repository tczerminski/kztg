{
  "title": "Któż jest tak święty jak nasz Pan?",
  "verses": [
    {
      "lines": [
        "Któż jest tak święty",
        "Jak nasz Pan?",
        "Bogiem jest tylko on!",
        "Nie ma innej skały tu –",
        "Tylko Bóg!",
        "Któż jest tak święty",
        "Jak nasz Pan?"
      ]
    }
  ]
}
