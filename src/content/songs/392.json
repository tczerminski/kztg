{
  "title": "Pan jest mocą swojego ludu",
  "verses": [
    {
      "lines": [
        "Pan jest mocą swojego ludu",
        "Pieśnią moją jest Pan",
        "Moja tarcza i moja moc",
        "On jest mym Bogiem",
        "Nie jestem sam",
        "W Nim moja siła",
        "Nie jestem sam"
      ]
    },
    {
      "lines": [
        "On prowadzi mnie drogą prawdy",
        "Wspiera każdy mój krok",
        "Łaską darzy każdego dnia",
        "On jest mym Bogiem",
        "Nie jestem sam",
        "W Nim moja siła",
        "Nie jestem sam"
      ]
    }
  ]
}
