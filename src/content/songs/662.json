{
  "title": "Zaśpiewaj Bogu pieśni chwały",
  "verses": [
    {
      "lines": [
        "Zaśpiewaj Bogu pieśni chwały",
        "Alleluja!"
      ]
    },
    {
      "lines": [
        "Gdyż Pan królem jest",
        "Całej ziemi",
        "Więc zawsze śpiewaj mu",
        "Z całego serca",
        "O klaszczcie, krzyczcie wraz!",
        "Wszyscy ludzie",
        "Bo On jest godzien",
        "Wszelkiej czci!"
      ]
    }
  ]
}
