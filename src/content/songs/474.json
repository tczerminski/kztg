{
  "title": "Skałą i zbawieniem… jest mój Pan",
  "verses": [
    {
      "lines": [
        "Skałą i zbawieniem",
        "Jest mój Jezus",
        "Skałą i zbawieniem jest mój Pan",
        "Skałą i zbawieniem jest baranek",
        "On mi nowe życie dał"
      ]
    },
    {
      "lines": [
        "Jezus wyciągnął do mnie dłoń",
        "Jezus radość w serce moje wlał",
        "Jezus z moich grzechów obmył",
        "Mnie swą krwią",
        "Najdroższą krwią"
      ]
    }
  ]
}
