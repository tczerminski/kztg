---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import { t, locales, defaultLocale, type Locale } from "../i18n/utils";
import { getSermonsForLocale } from "../lib/sermons";
import { getSongs } from "../lib/songs";
import { buildJsonLd } from "../lib/jsonld";
import Header from "../components/Header.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  locale: Locale;
  /** Overrides for a specific page (e.g. a sermon detail page) instead of the site-wide defaults. */
  pageTitle?: string;
  pageDescription?: string;
  pageImage?: string;
  pagePath?: string;
  /** Omit cross-locale hreflang/og:locale:alternate — use for pages with no per-locale equivalent URL. */
  skipHreflang?: boolean;
  /** Raw JSON-LD string to use instead of the site-wide sermons ItemList. */
  jsonLdOverride?: string;
}

const { locale, pageTitle, pageDescription, pageImage, pagePath, skipHreflang = false, jsonLdOverride } = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://kztg.pl";
const canonicalPath = pagePath ?? getRelativeLocaleUrl(locale, "/");
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogLocales: Record<Locale, string> = {
  pl: "pl_PL",
  en: "en_US",
  uk: "uk_UA",
  de: "de_DE",
  es: "es_ES",
  ta: "ta_IN",
};

const sermons = jsonLdOverride ? [] : await getSermonsForLocale(locale);
const songs = !jsonLdOverride && locale === defaultLocale ? await getSongs() : undefined;
const jsonLd = jsonLdOverride ?? buildJsonLd(sermons, siteUrl, canonicalUrl + "#sermons", locale, songs);
const ogImageUrl = pageImage ? new URL(pageImage, siteUrl).toString() : new URL("/images/og-image.jpg", siteUrl).toString();
const titleText = pageTitle ?? t(locale, "page.title");
const ogTitleText = pageTitle ?? t(locale, "site.name");
const descriptionText = pageDescription ?? t(locale, "radio.desc");
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{titleText}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#3f568f" />
    <meta name="description" content={descriptionText} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[locale]} />
    {!skipHreflang && locales.filter((lc) => lc !== locale).map((lc) => (
      <meta property="og:locale:alternate" content={ogLocales[lc]} />
    ))}
    <meta property="og:site_name" content={t(locale, "site.name")} />
    <meta property="og:title" content={ogTitleText} />
    <meta property="og:description" content={descriptionText} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleText} />
    <meta name="twitter:description" content={descriptionText} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonicalUrl} />
    {!skipHreflang && locales.map((lc) => (
      <link rel="alternate" hreflang={lc} href={new URL(getRelativeLocaleUrl(lc, "/"), siteUrl).toString()} />
    ))}
    {!skipHreflang && (
      <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl("pl", "/"), siteUrl).toString()} />
    )}

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" type="image/png" href="/images/icons/icon-48x48.png" />
    <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="preload"
      as="font"
      href="/fonts/noto-sans-v42-latin/noto-sans-v42-latin-regular.woff2"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://pub-8b5cdf2f2aed4a6e832dd72430dfacc1.r2.dev" crossorigin />

    <style>
      html, body { margin: 0; padding: 0; }
      body {
        background: #f9fafb;
        color: #111827;
        font-family: "Noto Sans", system-ui, -apple-system, sans-serif;
        min-height: 100vh;
      }
      .hidden { display: none !important; }
      .lang-btn--active { color: #7b8fc4; font-weight: 700; text-decoration: underline; }
      .lang-switcher--hero .lang-btn--active { color: #fff; font-weight: 700; text-decoration: underline; }
      html[lang="ta"] .mobile-hero-brand p { font-size: 1.6rem; line-height: 1.3; }
      #siteHeader { position: fixed; top: 0; left: 0; width: 100%; z-index: 50; background: rgba(255, 255, 255, 0.95); }
      #radio { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
      @media (max-width: 767px) {
        #radio .hero-overlay { background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.65)); }
      }
      #radio picture, #radio picture img { position: absolute; inset: 0; width: 100%; height: 100%; }
      #radio picture img { object-fit: cover; opacity: 0.7; }
      #radio .hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to right, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.5));
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen font-['EB_Garamond']">
    <div id="offlineBanner" class="hidden fixed top-4 left-4 right-4 z-90 mx-auto max-w-md rounded-xl bg-[#3f568f] text-white text-sm text-center px-4 py-3 shadow-lg">
      {t(locale, "offline.banner")}
    </div>
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <audio id="audioElement" preload="auto" class="hidden"></audio>
    <footer class="bg-white text-center py-4 text-gray-600 text-sm">
      <p>{t(locale, "footer.copyright")}</p>
      <button id="cookieSettingsBtn" type="button" class="mt-2 font-semibold text-[#7b8fc4] hover:text-[#263a63] hover:underline transition">
        {t(locale, "cookie.settings")}
      </button>
    </footer>
    <CookieBanner locale={locale} />

    <script src="../scripts/main.ts"></script>
  </body>
</html>
