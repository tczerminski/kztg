{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kztg",
  "compatibility_date": "2026-05-21",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kztg" }]
}
